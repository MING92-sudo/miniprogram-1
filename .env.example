# ─────────────────────────────────────────────────────────────
# 监管平台接口凭证 —— 模板文件
#
# 使用方法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 排除，严禁入库）
#   2. 将 .env 中的占位值替换为平台实际分配的真实值
#   3. .env 不得提交、不得截图、不得粘贴到聊天/工单/文档中
#
# 本文件只保留变量名与格式说明，永远不含真实值。
# ─────────────────────────────────────────────────────────────

# 智慧平台认证地址（2026-09-28 平台分配）
REG_AUTH_LOGIN_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/authService/login

# 业务接口服务根路径（2026-09-29 第五轮联调实测确认：
# 网关服务前缀 /api/wlw + 业务模块前缀 /maintenance；参数用表单 x-www-form-urlencoded，非 JSON）
REG_API_BASE_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/wlw/maintenance/

# ── 登录四参数（平台分配，禁止硬编码进代码）────────────────
# 参数名以 V1.5 规范 2.1 为准，注意平台通知中可能写作 scret（拼写笔误）
REG_USERNAME=
REG_KEY=
REG_APPCODE=
REG_SECRET=

# ── 上报行为开关 ────────────────────────────────────────────
# ★ 幂等性未经平台书面确认前必须保持 false（见 docs/06 问题 7）
#   true  = 失败自动重试 3 次（30s/2m/10m）
#   false = 失败即挂起，转人工处理（默认，更安全）
REG_RETRY_AUTO=false

# 存量记录接口（2.8）临时启用开关，平台关闭后置 false
REG_LEGACY_UPLOAD_ENABLED=false

# ── 对象存储（微信云托管托管桶；桶名/地域非凭证，application.yml 已带默认值）──
# COS_BUCKET 填「微信云托管控制台-对象存储-存储配置」中的桶名
# 云托管托管桶无静态密钥，走内网临时凭证（COS_AUTH_URL），无需 COS_SECRET_ID/KEY
# 仅自建 COS 桶（本地联调）才需要 COS_SECRET_ID / COS_SECRET_KEY
COS_BUCKET=
COS_REGION=ap-shanghai
COS_AUTH_URL=http://api.weixin.qq.com/_/cos/getauth

# ── 数据库（云端填云托管「数据库」或腾讯云 MySQL 的内网地址；本地用本机 MySQL）──
DB_HOST=
DB_PORT=3306
DB_NAME=maintenance
DB_USER=
DB_PASSWORD=

# ── 自建应用（云端必填；JWT 密钥 ≥32 字节强随机，本地默认值仅保证能启动）──
JWT_SECRET=
# 生产置 false（禁用演示种子数据）；首次部署需建库建表时保持 true 一次后改 false
SEED_DEMO_DATA=false
# 作业时长下限（分钟，签到→签退）；上线前待业务/合规确认，默认 30
APP_WORK_DURATION_MINUTES=30
# 后端监听端口（微信云托管模板约定 80，勿改）
SERVER_PORT=80

# ── 微信小程序登录（jscode2session；★ WX_APPSECRET 属凭证，严禁入库）──
# 来源：微信公众平台 → 开发管理 → 开发设置（AppID / AppSecret）
# 作用：/auth/bind-wechat、/auth/wx-login 用 wx.login 的 code 换真实 openid（P0 串号修复，
#       docs/04 A.1）。未配置时这两个接口直接报错。
# 注意：openid 只从 code 换取——不再有 DEV_OPENID / X-WX-OPENID 兜底（可伪造/会串号，已移除）。
WX_APPID=
WX_APPSECRET=
