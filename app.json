        "pkg-maintenance"
      ]
    },
    "pages/install/home/index": {
      "network": "all",
      "packages": [
        "pkg-handover"
      ]
    },
    "pages/client/home/index": {
      "network": "all",
      "packages": [
        "pkg-client"
      ]
