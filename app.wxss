/**app.wxss 全局样式**/
/* M2 深色工业风设计系统（.bw 作用域，旧页浅色体系暂留至 M6） */
@import './styles/tokens.wxss';
@import './assets/icons/icons.wxss';
@import './styles/fonts.wxss';
@import './styles/brand.wxss';
@import './styles/legacy-dark.wxss';

/* 新壳按钮重置（仅 .bw 内，避免影响旧页原生 button） */
.bw button{background:none;border:none;padding:0;margin:0;font-size:inherit;line-height:inherit;color:inherit}
.bw button::after{border:none}
.bw .page-pad{padding:18rpx 28rpx 20rpx}
.bw .tabbar-pad{padding-bottom:calc(152rpx + env(safe-area-inset-bottom,0px))}

page {
  /* 主题色（克制工业风：单蓝 + 三语义色） */
  --em-brand: #0A5BD3;
  --em-brand-light: #E8F0FB;
  --em-success: #0F8A5F;
  --em-success-bg: #E6F4EE;
  --em-warning: #B85C0A;
  --em-warning-bg: #FBF0E4;
  --em-error: #C2382B;
  --em-error-bg: #FBE9E7;
  --em-neutral: #6B7480;
  --em-neutral-bg: #F0F1F3;
  --em-text-primary: #1A1E26;
  --em-text-secondary: #5C6572;
  --em-text-disabled: #9AA3AF;
  --em-bg-page: #F2F4F7;
  --em-bg-card: #FFFFFF;
  --em-border: #E4E8EE;
  --em-radius-sm: 8rpx;
  --em-radius: 12rpx;
  --em-radius-lg: 16rpx;

  background-color: var(--em-bg-page);
  color: var(--em-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用卡片 */
.em-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: var(--em-bg-card);
  border-radius: var(--em-radius);
  box-sizing: border-box;
}

/* 页面容器 */
.em-page {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用主按钮 */
.em-btn-primary {
  background: var(--em-brand);
  color: #ffffff;
  border-radius: var(--em-radius);
}

/* 辅助文字 */
.em-text-secondary {
  color: var(--em-text-secondary);
  font-size: 24rpx;
}

/* 未登录空状态（登录规范：先浏览功能，后自行选择登录） */
.guest-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 64rpx 0;
}

.guest-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--em-text-primary);
}

.guest-empty-sub {
  font-size: 26rpx;
  color: var(--em-text-secondary);
  margin-top: 16rpx;
}

.guest-empty-btn {
  margin-top: 64rpx;
  width: 320rpx;
  background: var(--em-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  line-height: 2.6;
}
.guest-empty-btn::after {
  border: none;
}

/* 列表/表单页统一页头（门户内页与员工页共用，避免每页各写一套） */
.page-head {
  padding: 32rpx 32rpx 8rpx;
}

.page-head-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--em-text-primary);
}

.page-head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--em-text-secondary);
  line-height: 1.6;
}
