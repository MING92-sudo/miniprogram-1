/**app.wxss 全局样式**/
page {
  /* 主题色（克制工业风：单蓝 + 三语义色） */
  --em-brand: #0A5BD3;
  --em-brand-light: #E8F0FB;
  --em-success: #0F8A5F;
  --em-success-bg: #E6F4EE;
  --em-warning: #B85C0A;
  --em-warning-bg: #FBF0E4;
  --em-error: #C2382B;
  --em-error-bg: #FBE9E7;
  --em-neutral: #6B7480;
  --em-neutral-bg: #F0F1F3;
  --em-text-primary: #1A1E26;
  --em-text-secondary: #5C6572;
  --em-text-disabled: #9AA3AF;
  --em-bg-page: #F2F4F7;
  --em-bg-card: #FFFFFF;
  --em-border: #E4E8EE;
  --em-radius-sm: 8rpx;
  --em-radius: 12rpx;
  --em-radius-lg: 16rpx;

  background-color: var(--em-bg-page);
  color: var(--em-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用卡片 */
.em-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: var(--em-bg-card);
  border-radius: var(--em-radius);
  box-sizing: border-box;
}

/* 页面容器 */
.em-page {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用主按钮 */
.em-btn-primary {
  background: var(--em-brand);
  color: #ffffff;
  border-radius: var(--em-radius);
}

/* 辅助文字 */
.em-text-secondary {
  color: var(--em-text-secondary);
  font-size: 24rpx;
}
