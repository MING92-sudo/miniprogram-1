# 复制到项目根 .env 或以环境变量方式注入（backend 不单独建 .env，统一读根目录凭证）
REG_AUTH_LOGIN_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/authService/login
REG_API_BASE_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/wlw/maintenance/
REG_USERNAME=
REG_KEY=
REG_APPCODE=
REG_SECRET=
REG_RETRY_AUTO=false
REG_LEGACY_UPLOAD_ENABLED=false

# 自建后端运行配置；生产环境必须显式注入强随机 JWT secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maintenance
DB_USERNAME=root
DB_PASSWORD=
APP_JWT_SECRET=change-me-before-production-32-bytes-minimum!
APP_JWT_TTL_HOURS=12
APP_FILE_ROOT=./data/files
APP_WORK_DURATION_MINUTES=30
DB_SEED_DEMO=true

# 对象存储：桶名/地域非凭证（application.yml 已带云托管托管桶默认值，可不填）；
# 云托管托管桶无静态密钥，走内网临时凭证；仅自建 COS 桶才填 COS_SECRET_ID/COS_SECRET_KEY
#COS_BUCKET=
#COS_REGION=ap-shanghai
#COS_SECRET_ID=
#COS_SECRET_KEY=
