# 复制到项目根 .env 或以环境变量方式注入（backend 不单独建 .env，统一读根目录凭证）
REG_AUTH_LOGIN_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/authService/login
REG_API_BASE_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/wlw/maintenance/
REG_USERNAME=
REG_KEY=
REG_APPCODE=
REG_SECRET=
REG_LEGACY_UPLOAD_ENABLED=false

# 自建后端运行配置；变量名与 application.yml 保持一致（生产必须显式注入强随机 JWT secret）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maintenance
DB_USERNAME=root
DB_PASSWORD=
# JWT 签名密钥：无默认值，缺失即启动失败；生产必须注入强随机值（>=32 字节），严禁使用示例占位值
JWT_SECRET=
JWT_EXPIRE_HOURS=72
FILE_STORAGE_DIR=./data/files
APP_WORK_DURATION_MINUTES=30
SEED_DEMO_DATA=false

# 对象存储：桶名/地域非凭证（application.yml 已带云托管托管桶默认值，可不填）；
# 云托管托管桶无静态密钥，走内网临时凭证；仅自建 COS 桶才填 COS_SECRET_ID/COS_SECRET_KEY
#COS_BUCKET=
#COS_REGION=ap-shanghai
#COS_SECRET_ID=
#COS_SECRET_KEY=

# 微信小程序凭证（生产必填，/auth/wx-login、/auth/bind-wechat 用）
#WX_APPID=
#WX_APPSECRET=
