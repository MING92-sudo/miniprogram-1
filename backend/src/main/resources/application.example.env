# 复制到项目根 .env 或以环境变量方式注入（backend 不单独建 .env，统一读根目录凭证）
REG_AUTH_LOGIN_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/authService/login
REG_API_BASE_URL=https://tzsb.scjgj.cq.gov.cn:1443/api/wlw/maintenance/
REG_USERNAME=
REG_KEY=
REG_APPCODE=
REG_SECRET=
REG_LEGACY_UPLOAD_ENABLED=false

# 自建后端运行配置；生产环境必须显式注入强随机 JWT secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maintenance
DB_USERNAME=root
DB_PASSWORD=
# JWT 密钥无默认值，缺失/空白即启动失败（AGENTS §2.3）；example 只留变量名
JWT_SECRET=
JWT_EXPIRE_HOURS=72
APP_FILE_ROOT=./data/files
APP_WORK_DURATION_MINUTES=30
SEED_DEMO_DATA=false

# 微信 code 换 openid；只放真实环境变量，示例不得填真实 secret
WX_APPID=
WX_APPSECRET=
# 云出口自签网关证书 SHA-256 白名单（逗号分隔，支持轮换）；默认留空=严格 PKIX
WX_GATEWAY_TRUSTED_SHA256=
# 云托管 Pod 每次发布会换出口自签证书；true 时仅微信登录链路按 CN=api.weixin.qq.com + 自签放行
WX_GATEWAY_TRUST_SELF_SIGNED=false

# 对象存储：桶名/地域非凭证（application.yml 已带云托管托管桶默认值，可不填）；
# 云托管托管桶无静态密钥，走内网临时凭证；仅自建 COS 桶才填 COS_SECRET_ID/COS_SECRET_KEY
#COS_BUCKET=
#COS_REGION=ap-shanghai
#COS_SECRET_ID=
#COS_SECRET_KEY=
