<view class="kpi-row">
  <view wx:for="{{items}}" wx:key="label" class="kpi {{item.alert ? 'kpi-alert' : ''}}" data-item="{{item}}" bindtap="onTap" aria-role="button" aria-label="{{item.label}}">
    <view class="mono kpi-n">{{item.value}}</view>
    <view class="fs20 muted">{{item.label}}</view>
  </view>
</view>
