/* 快捷动作宫格自有作用域样式（确保原型 4 列，不依赖全局 .bw 穿透） */
.qa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14rpx}
.qa{background:#FFFFFF;border:1rpx solid #DCE3E8;border-radius:6rpx;padding:18rpx 6rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;font-size:20rpx;color:#4F616B;text-align:center;line-height:1.3}
.qa::after{border:none}
.qa .i{font-size:30rpx;color:var(--amber)}