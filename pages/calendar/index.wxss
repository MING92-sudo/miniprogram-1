.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}

.filter-chip {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: var(--em-text-secondary);
  background: var(--em-bg-card);
  border-radius: 999rpx;
}

.filter-chip.is-active {
  color: #ffffff;
  background: var(--em-brand);
}

.head-card {
  margin-top: 20rpx;
}

.range {
  margin-top: 8rpx;
}

.month-title {
  padding: 8rpx 32rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--em-text-primary);
}

.day-card {
  margin-top: 16rpx;
}

.day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--em-border);
}

.day-date {
  font-size: 32rpx;
  font-weight: 600;
}

.day-week {
  font-size: 24rpx;
  color: var(--em-text-secondary);
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.entry:last-child {
  border-bottom: none;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.type-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  color: var(--em-brand);
  background: var(--em-brand-light);
}

.type-OY {
  color: var(--em-error);
  background: var(--em-error-bg);
}

.type-SM {
  color: var(--em-warning);
  background: var(--em-warning-bg);
}

.type-TM {
  color: var(--em-success);
  background: var(--em-success-bg);
}

.em-btn-ghost {
  margin-top: 16rpx;
  background: var(--em-brand-light);
  color: var(--em-brand);
  border-radius: var(--em-radius);
}

.retry {
  margin-top: 16rpx;
}
