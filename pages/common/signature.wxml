<view class="sig-page">
  <canvas
    id="sig-canvas"
    class="sig-canvas"
    type="2d"
    disable-scroll="{{true}}"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
  ></canvas>

  <view class="sig-actions">
    <button size="mini" bindtap="onClear">清除</button>
    <button size="mini" class="em-btn-primary" bindtap="onConfirm">确认签名</button>
  </view>
</view>
