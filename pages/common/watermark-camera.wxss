.wm-info {
  color: var(--em-text-secondary);
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.wm-wrap {
  position: relative;
  width: 100%;
  height: 600rpx;
}

.wm-canvas {
  width: 100%;
  height: 600rpx;
  border-radius: var(--em-radius);
  background: #000000;
}

.preview-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
}

.retake {
  margin-top: 20rpx;
  text-align: center;
  color: var(--em-text-secondary);
}
