<view class="em-page">
  <view class="em-card">
    <view class="section-title">{{elevatorName}}</view>
    <view class="em-text-secondary">检查项共 {{total}} 项（年度维保并集）· 已填 {{marked}} · 不合格 {{abnormal}}</view>
    <view class="run-actions">
      <button size="mini" class="sign-btn {{inspectorSign ? 'sign-done' : ''}}" data-field="inspectorSign" bindtap="goSignature">
        {{inspectorSign ? '检查人员已签字' : '检查人员签字'}}
      </button>
      <button size="mini" class="sign-btn {{reviewerSign ? 'sign-done' : ''}}" data-field="reviewerSign" bindtap="goSignature">
        {{reviewerSign ? '审核人员已签字' : '审核人员签字'}}
      </button>
    </view>
  </view>

  <view class="em-card">
    <button size="mini" bindtap="markAllNormal">一键全部合格</button>
  </view>

  <view wx:for="{{items}}" wx:key="itemCode" class="em-card item-row">
    <view class="item-head">
      <view class="item-name">{{item.itemCode}} {{item.name}}</view>
    </view>
    <view class="em-text-secondary">{{item.requirement}}</view>
    <view class="result-row">
      <view
        class="result-btn {{item.result === 'NORMAL' ? 'result-normal' : ''}}"
        data-index="{{index}}"
        data-result="NORMAL"
        bindtap="markResult"
      >合格</view>
      <view
        class="result-btn {{item.result === 'ABNORMAL' ? 'result-abnormal' : ''}}"
        data-index="{{index}}"
        data-result="ABNORMAL"
        bindtap="markResult"
      >不合格</view>
    </view>
    <input
      wx:if="{{item.result === 'ABNORMAL'}}"
      class="abnormal-input"
      value="{{item.abnormalDesc}}"
      data-index="{{index}}"
      bindinput="onDescInput"
      placeholder="请描述不合格情况"
    />
  </view>

  <view class="em-card">
    <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '生成自行检查记录'}}
    </button>
    <view class="em-text-secondary submit-tip">记录归入电梯安全技术档案（留存 ≥4 年），不触发平台上报</view>
  </view>
</view>
