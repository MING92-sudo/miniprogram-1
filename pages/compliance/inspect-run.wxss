.run-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sign-btn.sign-done {
  color: var(--em-success, #2ba471);
}

.item-row .result-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.result-btn {
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: var(--em-bg-page);
  color: var(--em-text-secondary);
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.result-normal {
  color: var(--em-success, #2ba471);
  border-color: var(--em-success, #2ba471);
  background: rgba(43, 164, 113, 0.08);
}

.result-abnormal {
  color: #e34d59;
  border-color: #e34d59;
  background: rgba(227, 77, 89, 0.08);
}

.abnormal-input {
  margin-top: 12rpx;
  border: 2rpx solid var(--em-border, #e5e6eb);
  border-radius: var(--em-radius);
  padding: 12rpx 20rpx;
}

.submit-tip {
  text-align: center;
  margin-top: 16rpx;
}
