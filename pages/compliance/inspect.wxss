.inspect-item {
  position: relative;
}

.status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-ok {
  color: var(--em-success, #2ba471);
  background: rgba(43, 164, 113, 0.1);
}

.status-overdue {
  color: #e34d59;
  background: rgba(227, 77, 89, 0.1);
}

.status-todo {
  color: #e37318;
  background: rgba(227, 115, 24, 0.1);
}
