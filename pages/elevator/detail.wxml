<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">{{loadingText}}</view>

  <block wx:if="{{profile}}">
    <!-- 头部：名称 + 类别 -->
    <view class="em-card">
      <view class="head-row">
        <view class="el-name">{{profile.local.projectName || '-'}}</view>
        <view wx:if="{{profile.category}}" class="el-cat">{{profile.category}}</view>
      </view>
      <view class="em-text-secondary">{{profile.insideNumber ? '内部编号 ' + profile.insideNumber + ' · ' : ''}}{{profile.model || '-'}}</view>
    </view>

    <!-- 平台同步信息（2.7 自动获取，docs/04 B.7） -->
    <view class="em-card">
      <view class="section-title">平台同步信息</view>
      <view class="info-row"><text>电梯编号</text><text>{{profile.platform.elevatorCode || '-'}}</text></view>
      <view class="info-row"><text>注册代码</text><text>{{profile.platform.registrationCode || '-'}}</text></view>
      <view class="info-row"><text>设备代码</text><text>{{profile.platform.deviceCode || '-'}}</text></view>
      <view class="info-row"><text>出厂编号</text><text>{{profile.platform.factoryNumber || '-'}}</text></view>
      <view class="info-row"><text>安全管理员</text><text>{{profile.platform.elevatorAdminister || '-'}}</text></view>
      <view class="info-row"><text>管理员电话</text><text>{{profile.platform.elevatorAdministerPhone || '-'}}</text></view>
      <view class="info-row"><text>应急电话</text><text>{{profile.platform.emergencyPhone || '-'}}</text></view>
      <view class="em-text-secondary" wx:if="{{profile.platform.syncedAt}}">同步时间：{{profile.platform.syncedAt}}</view>
    </view>

    <!-- 本地维护信息（平台不提供，本地建档维护；维保人员现场可更正，docs/01 §3.4.1） -->
    <view class="em-card">
      <view class="section-title">本地维护信息</view>
      <view class="info-row" data-field="projectName" bindtap="onEditLocal">
        <text>项目名称</text>
        <text class="info-editable">{{profile.local.projectName || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row"><text>使用单位负责人</text><text>{{profile.local.unitPrincipal || '-'}}</text></view>
      <view class="info-row" data-field="address" bindtap="onEditLocal">
        <text>安装地址</text>
        <text class="info-editable">{{profile.local.address || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" wx:if="{{profile.local.lng && profile.local.lat}}"><text>经纬度</text><text>{{profile.local.lng}}, {{profile.local.lat}}</text></view>
      <view class="info-row" data-field="brand" bindtap="onEditLocal">
        <text>品牌</text>
        <text class="info-editable">{{profile.local.brand || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="manufacturer" bindtap="onEditLocal">
        <text>制造单位</text>
        <text class="info-editable">{{profile.local.manufacturer || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="productNo" bindtap="onEditLocal">
        <text>产品编号</text>
        <text class="info-editable">{{profile.local.productNo || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="driveMode" bindtap="onEditLocal">
        <text>驱动方式</text>
        <text class="info-editable">{{profile.local.driveMode || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="ratedLoad" bindtap="onEditLocal">
        <text>额定载重</text>
        <text class="info-editable">{{profile.local.ratedLoad || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="ratedSpeed" bindtap="onEditLocal">
        <text>额定速度</text>
        <text class="info-editable">{{profile.local.ratedSpeed || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="stationsDoors" bindtap="onEditLocal">
        <text>层站/门</text>
        <text class="info-editable">{{profile.local.stationsDoors || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="nextCheckDate" bindtap="onEditLocal">
        <text>下次检验日期</text>
        <text class="info-editable">{{profile.local.nextCheckDate || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
      <view class="info-row" data-field="nextMaintenanceDate" bindtap="onEditLocal">
        <text>下次维保日期</text>
        <text class="info-editable">{{profile.local.nextMaintenanceDate || '待补充'}} <text class="info-edit-hint">修改</text></text>
      </view>
    </view>
  </block>
</view>
