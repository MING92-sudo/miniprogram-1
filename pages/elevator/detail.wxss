/* 电梯设备详情：卡片 + 信息行 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.el-name {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.el-cat {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
  color: var(--em-brand);
  background: var(--em-brand-light);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--em-text-secondary);
}

.info-row text:first-child {
  color: var(--em-text-primary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-row text:last-child {
  text-align: right;
}

/* 项目名称（小区名称）现场可更正：维保人员点按直接修改（docs/01 §3.4.1） */
.info-editable {
  min-height: 48rpx;
}

.info-edit-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--em-brand);
}
