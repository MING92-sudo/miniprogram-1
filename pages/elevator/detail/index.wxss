page{background:var(--ink);color:var(--text)}
.ed-hero{display:flex;align-items:center;gap:24rpx}
.ed-qr{width:120rpx;height:120rpx;flex:none;background:#F2EEE2;border-radius:4rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;box-shadow:0 0 0 1rpx #3A4A51}
.ed-qr-ico{font-size:56rpx;color:#22201A}
.ed-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}
.ed-mini{border:1rpx solid #243138;background:#111A1F;border-radius:4rpx;padding:14rpx 16rpx;display:flex;flex-direction:column;gap:6rpx}
.ed-edit{cursor:pointer}