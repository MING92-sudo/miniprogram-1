<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>
  <view wx:if="{{!loading && list.length === 0}}" class="em-card em-text-secondary">暂无电梯</view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="em-card el-item"
    data-id="{{item.id}}"
    bindtap="goProfile"
  >
    <view class="el-main">
      <view class="el-name">{{item.elevatorName}}</view>
      <view class="em-text-secondary">{{item.elevatorCode}} · {{item.model || '-'}}</view>
      <view class="em-text-secondary">{{item.projectName || '-'}}</view>
    </view>
    <view class="el-arrow">›</view>
  </view>
</view>
