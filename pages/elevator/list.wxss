/* 电梯设备列表：单蓝页头 + 搜索 + 设备卡 */
.el-page {
  min-height: 100vh;
  background: var(--em-bg-page);
  padding-bottom: 40rpx;
}

/* ── 蓝色页头 ── */
.el-header {
  background: var(--em-brand);
  padding: 32rpx 24rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.el-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 28rpx;
}

.el-search {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}

.el-search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--em-text-primary);
}

/* ── 设备卡片 ── */
.el-list {
  padding: 20rpx 24rpx 0;
}

.el-empty {
  text-align: center;
  color: var(--em-text-secondary);
}

.el-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(10, 91, 211, 0.06);
}

.el-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.el-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--em-text-primary);
}

.el-arrow {
  font-size: 36rpx;
  color: var(--em-text-disabled);
  flex-shrink: 0;
}

.el-code {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--em-brand);
  background: var(--em-brand-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.el-info {
  margin-top: 20rpx;
  background: var(--em-bg-page);
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
}

.el-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.el-label {
  color: var(--em-text-secondary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.el-value {
  color: var(--em-text-primary);
  text-align: right;
}
