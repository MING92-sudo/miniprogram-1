<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">档案加载中...</view>

  <block wx:if="{{profile}}">
    <view class="em-card">
      <view class="prof-head">
        <view class="prof-name">{{profile.elevatorName}}</view>
        <view class="prof-cat">{{profile.category}}</view>
      </view>
      <view class="info-row"><text class="info-label">单位内编号：</text><text class="info-value">{{profile.insideNumber || '-'}}</text></view>
      <view class="info-row"><text class="info-label">电梯型号：</text><text class="info-value">{{profile.model || '-'}}</text></view>
      <view wx:if="{{profile.platform.syncedAt}}" class="prof-synced">平台档案同步于 {{profile.platform.syncedAt}}</view>
    </view>

    <view class="em-card">
      <view class="section-title">注册信息<text class="src-badge src-platform">平台 2.7 自动获取</text></view>
      <view class="info-row"><text class="info-label">电梯编码：</text><text class="info-value">{{profile.platform.elevatorCode || '-'}}</text></view>
      <view class="info-row"><text class="info-label">使用登记证号：</text><text class="info-value">{{profile.platform.registrationCode || '-'}}</text></view>
      <view class="info-row"><text class="info-label">设备代码：</text><text class="info-value">{{profile.platform.deviceCode || '-'}}</text></view>
      <view class="info-row"><text class="info-label">出厂编号：</text><text class="info-value">{{profile.platform.factoryNumber || '-'}}</text></view>
      <view class="info-row">
        <text class="info-label">使用单位主体ID：</text>
        <text class="info-value entity-id" bindtap="copyEntityId">{{profile.platform.useUnitEntityId || '-'}}</text>
      </view>
      <view class="info-row"><text class="info-label">电梯安全管理员：</text><text class="info-value">{{profile.platform.elevatorAdminister || '-'}}</text></view>
      <view class="info-row"><text class="info-label">安全管理员电话：</text><text class="info-value">{{profile.platform.elevatorAdministerPhone || '-'}}</text></view>
      <view class="info-row"><text class="info-label">紧急联系电话：</text><text class="info-value">{{profile.platform.emergencyPhone || '-'}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">使用单位<text class="src-badge src-local">本地维护</text></view>
      <view class="info-row"><text class="info-label">项目名称（使用单位）：</text><text class="info-value">{{profile.local.projectName || '-'}}</text></view>
      <view class="info-row"><text class="info-label">单位负责人：</text><text class="info-value">{{profile.local.unitPrincipal || '-'}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">基本技术参数（TSG 第八条）<text class="src-badge src-local">本地维护</text></view>
      <view class="info-row"><text class="info-label">驱动方式：</text><text class="info-value">{{profile.local.driveMode || '-'}}</text></view>
      <view class="info-row"><text class="info-label">额定载重量：</text><text class="info-value">{{profile.local.ratedLoad || '-'}}</text></view>
      <view class="info-row"><text class="info-label">额定速度：</text><text class="info-value">{{profile.local.ratedSpeed || '-'}}</text></view>
      <view class="info-row"><text class="info-label">层站门数：</text><text class="info-value">{{profile.local.stationsDoors || '-'}}</text></view>
      <view class="info-row"><text class="info-label">品牌：</text><text class="info-value">{{profile.local.brand || '-'}}</text></view>
      <view class="info-row"><text class="info-label">制造单位：</text><text class="info-value">{{profile.local.manufacturer || '-'}}</text></view>
      <view class="info-row"><text class="info-label">产品编号：</text><text class="info-value">{{profile.local.productNo || '-'}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">位置与检验<text class="src-badge src-local">本地维护</text></view>
      <view class="info-row"><text class="info-label">安装地址：</text><text class="info-value">{{profile.local.address || '-'}}</text></view>
      <view class="info-row"><text class="info-label">经纬度：</text><text class="info-value">{{profile.local.lng}}, {{profile.local.lat}}</text></view>
      <view class="info-row"><text class="info-label">下次检验日期：</text><text class="info-value">{{profile.local.nextCheckDate || '-'}}</text></view>
      <view class="info-row"><text class="info-label">下次维保日期：</text><text class="info-value">{{profile.local.nextMaintenanceDate || '-'}}</text></view>
    </view>
  </block>
</view>
