.prof-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.prof-name {
  font-size: 34rpx;
  font-weight: 700;
}

.prof-cat {
  font-size: 22rpx;
  color: #1668dc;
  background: rgba(22, 104, 220, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.prof-synced {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--em-success, #2ba471);
}

.src-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  vertical-align: middle;
}

.src-platform {
  color: #1668dc;
  background: rgba(22, 104, 220, 0.08);
}

.src-local {
  color: #fa8c16;
  background: rgba(250, 140, 22, 0.1);
}

.src-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--em-text-secondary, #86909c);
}

.entity-id {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1668dc;
}
