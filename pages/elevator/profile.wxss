.prof-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.prof-name {
  font-size: 34rpx;
  font-weight: 700;
}

.prof-cat {
  font-size: 22rpx;
  color: #1668dc;
  background: rgba(22, 104, 220, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.prof-synced {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--em-success, #2ba471);
}

.src-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  vertical-align: middle;
}

.src-platform {
  color: #1668dc;
  background: rgba(22, 104, 220, 0.08);
}

.src-local {
  color: #fa8c16;
  background: rgba(250, 140, 22, 0.1);
}

/* 字段行：字段名（灰）+ 冒号 + 内容（深色），左对齐、内容可换行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}

.info-label {
  color: #86909c;
  flex-shrink: 0;
}

.info-value {
  color: #1d2129;
  font-weight: 500;
  word-break: break-all;
}

.entity-id {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1668dc;
}
