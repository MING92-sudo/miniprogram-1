<view class="em-page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="em-card em-text-secondary empty">
    暂无急修单
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="em-card fault-item"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="fault-head">
      <view class="fault-title">{{item.elevatorCode || '电梯'}}</view>
      <view class="tag tag-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="em-text-secondary">单号 {{item.id}}</view>
    <view class="em-text-secondary">{{item.desc || ''}}</view>
    <view class="em-text-secondary fault-time">{{item.createdAt || ''}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip em-text-secondary">加载中...</view>

  <view class="em-card">
    <button class="em-btn-primary" bindtap="goReport">新建急修单</button>
  </view>
</view>
