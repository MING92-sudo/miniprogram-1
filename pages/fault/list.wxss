.tabs {
  display: flex;
  background: #ffffff;
  padding: 20rpx 12rpx;
  gap: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--em-text-secondary);
  background: var(--em-bg-page);
}

.tab-active {
  background: var(--em-brand);
  color: #ffffff;
  font-weight: 600;
}

.fault-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fault-title {
  font-weight: 600;
}

.tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-OPEN {
  color: var(--em-warning);
  background: #fdf6ec;
}

.tag-CLOSED {
  color: var(--em-success);
  background: #e8f7f0;
}

.fault-time {
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
}

.loading-tip {
  text-align: center;
  padding: 24rpx;
}
