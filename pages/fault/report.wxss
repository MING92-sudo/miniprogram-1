.form-label {
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input,
.form-textarea {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  width: 100%;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  box-sizing: border-box;
}

.scan-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  background: var(--em-brand-light);
  color: var(--em-brand);
  border-radius: var(--em-radius);
}

.elevator-info {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--em-brand-light);
  border-radius: var(--em-radius);
}

.info-line {
  font-size: 28rpx;
}

.info-sub {
  color: var(--em-text-secondary);
  font-size: 24rpx;
}

.form-textarea {
  padding: 16rpx 20rpx;
  min-height: 160rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  width: 100%;
  box-sizing: border-box;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--em-radius);
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #00000099;
  color: #fff;
  border-radius: 0 0 0 var(--em-radius);
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  color: var(--em-text-secondary);
  font-size: 64rpx;
}
