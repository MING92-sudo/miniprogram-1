.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-no {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tag {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
  color: var(--em-warning);
  background: var(--em-warning-bg);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: var(--em-text-secondary);
}

.info-row text:first-child {
  color: var(--em-text-primary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-row text:last-child {
  text-align: right;
}

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.field-label {
  width: 200rpx;
  flex-shrink: 0;
}

.req {
  color: var(--em-error);
  margin-left: 4rpx;
}

.field-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: right;
}

.field-textarea {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  font-size: 26rpx;
}

.field-tip {
  margin-top: 12rpx;
}

.sign-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.sign-cell {
  flex: 1;
}

.sign-title {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.sign-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  overflow: hidden;
}

.sign-box image {
  width: 100%;
  height: 100%;
}

.sign-add {
  font-size: 26rpx;
  color: var(--em-text-secondary);
}
