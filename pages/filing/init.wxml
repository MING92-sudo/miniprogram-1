<view class="em-page">
  <block wx:if="{{canWrite}}">
    <view class="em-card">
      <view class="section-title">合同前置</view>
      <block wx:if="{{!unitManual}}">
        <view class="field">
          <view class="field-label">使用单位<text class="req">*</text></view>
          <picker mode="selector" range="{{unitLabels}}" value="{{unitIndex}}" bindchange="onUnitChange">
            <view class="field-picker">
              {{unitIndex > -1 ? unitLabels[unitIndex] : '请选择使用单位（本单位电梯归属）'}}
              <text class="field-arrow">›</text>
            </view>
          </picker>
        </view>
      </block>
      <block wx:else>
        <view class="em-text-secondary tip">{{text.USEUNIT_UNAVAILABLE}}</view>
        <view class="field">
          <view class="field-label">使用单位 ID<text class="req">*</text></view>
          <input class="field-input" value="{{manualUseUnitId}}" data-field="manualUseUnitId" bindinput="onManualInput" placeholder="useUnitId" />
        </view>
      </block>

      <block wx:if="{{!contractManual}}">
        <view class="field">
          <view class="field-label">已生效合同<text class="req">*</text></view>
          <picker mode="selector" range="{{contractLabels}}" value="{{contractIndex}}" bindchange="onContractChange">
            <view class="field-picker">
              {{contractIndex > -1 ? contractLabels[contractIndex] : (unitIndex > -1 ? '请选择已生效合同' : '请先选择使用单位')}}
              <text class="field-arrow">›</text>
            </view>
          </picker>
        </view>
      </block>
      <block wx:else>
        <view class="em-text-secondary tip">{{text.CONTRACT_UNAVAILABLE}}</view>
        <view class="field">
          <view class="field-label">合同 ID<text class="req">*</text></view>
          <input class="field-input" value="{{manualContractId}}" data-field="manualContractId" bindinput="onManualInput" placeholder="contractId" />
        </view>
      </block>
      <view class="em-text-secondary tip">合同须已生效且今天在合同期内，且属于所选使用单位；同梯已有其他生效合同将被拒绝</view>
    </view>

    <view class="em-card">
      <view class="section-title">项目与检验信息</view>
      <view class="field">
        <view class="field-label">项目名称（小区）</view>
        <input class="field-input" value="{{form.projectName}}" data-field="projectName" bindinput="onInput" placeholder="如：世纪大厦" />
      </view>
      <view class="field">
        <view class="field-label">监督检验合格日</view>
        <picker mode="date" value="{{form.supervisionPassDate}}" bindchange="onDateChange">
          <view class="field-picker">{{form.supervisionPassDate || '请选择日期'}}<text class="field-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">维保类别</view>
        <picker mode="selector" range="{{workTypeLabels}}" value="{{workTypeIndex}}" bindchange="onWorkTypeChange">
          <view class="field-picker">
            {{workTypeIndex > -1 ? workTypeLabels[workTypeIndex] : '请选择维保类别（首保按半月保预建）'}}
            <text class="field-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">电梯信息（归档即建电梯档案）</view>
      <view class="field">
        <view class="field-label">电梯代码</view>
        <input class="field-input" value="{{form.elevatorCode}}" data-field="elevatorCode" bindinput="onInput" placeholder="平台 elevator_code" />
      </view>
      <view class="field">
        <view class="field-label">电梯名称</view>
        <input class="field-input" value="{{form.elevatorName}}" data-field="elevatorName" bindinput="onInput" placeholder="如：1# 客梯" />
      </view>
      <view class="field">
        <view class="field-label">电梯品种</view>
        <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="field-picker">{{form.category || '请选择品种（TSG T5002 四类）'}}<text class="field-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">安装地址</view>
        <input class="field-input" value="{{form.location}}" data-field="location" bindinput="onInput" placeholder="楼栋门牌" />
      </view>
      <view class="field">
        <view class="field-label">注册代码</view>
        <input class="field-input" value="{{form.regCode}}" data-field="regCode" bindinput="onInput" placeholder="使用登记证编号" />
      </view>
      <view class="field">
        <view class="field-label">设备代码</view>
        <input class="field-input" value="{{form.deviceCode}}" data-field="deviceCode" bindinput="onInput" placeholder="设备代码" />
      </view>
      <view class="field">
        <view class="field-label">内部编号</view>
        <input class="field-input" value="{{form.insideNumber}}" data-field="insideNumber" bindinput="onInput" placeholder="如：KT-01" />
      </view>
      <view class="field">
        <view class="field-label">型号</view>
        <input class="field-input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="如：OTIS 300VF" />
      </view>
      <view class="field">
        <view class="field-label">品牌</view>
        <input class="field-input" value="{{form.brand}}" data-field="brand" bindinput="onInput" placeholder="品牌" />
      </view>
      <view class="field">
        <view class="field-label">制造单位</view>
        <input class="field-input" value="{{form.manufacturer}}" data-field="manufacturer" bindinput="onInput" placeholder="制造单位全称" />
      </view>
      <view class="field">
        <view class="field-label">产品编号</view>
        <input class="field-input" value="{{form.productNo}}" data-field="productNo" bindinput="onInput" placeholder="出厂编号" />
      </view>
      <view class="field">
        <view class="field-label">驱动方式</view>
        <input class="field-input" value="{{form.driveMode}}" data-field="driveMode" bindinput="onInput" placeholder="如：曳引驱动" />
      </view>
      <view class="field">
        <view class="field-label">额定载重</view>
        <input class="field-input" type="number" value="{{form.ratedLoad}}" data-field="ratedLoad" bindinput="onInput" placeholder="1000" />
        <text class="field-unit">{{form.ratedLoadUnit}}</text>
      </view>
      <view class="field">
        <view class="field-label">额定速度</view>
        <input class="field-input" type="digit" value="{{form.ratedSpeed}}" data-field="ratedSpeed" bindinput="onInput" placeholder="1.75" />
        <text class="field-unit">{{form.ratedSpeedUnit}}</text>
      </view>
      <view class="field">
        <view class="field-label">层站/门</view>
        <input class="field-input" value="{{form.stationsDoors}}" data-field="stationsDoors" bindinput="onInput" placeholder="如：11/11" />
      </view>
    </view>

    <view class="em-card">
      <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">发起建档</button>
      <view class="em-text-secondary tip">发起后进入「资料收集中」，缺件可标缺件待补办</view>
    </view>
  </block>

  <view wx:else class="em-card">
    <view class="section-title">外接建档</view>
    <view class="em-text-secondary">{{text.READONLY_TIP}}</view>
  </view>
</view>
