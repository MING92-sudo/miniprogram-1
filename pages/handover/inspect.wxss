.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
}

.item-req {
  font-size: 22rpx;
  color: var(--em-text-secondary);
}

.item-results {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.item-radio {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.res-PASS {
  color: var(--em-success);
}

.res-FAIL {
  color: var(--em-error);
}

.res-NA {
  color: var(--em-text-secondary);
}

.fail-tip {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: var(--em-error);
  background: var(--em-error-bg);
  border-radius: var(--em-radius);
}

.item-remark {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  font-size: 26rpx;
}
