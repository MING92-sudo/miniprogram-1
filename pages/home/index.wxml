<view class="home-page">
  <!-- 顶部渐变 Banner -->
  <view class="banner">
    <view class="banner-deco banner-deco-1"></view>
    <view class="banner-deco banner-deco-2"></view>
    <view class="banner-title">无纸化维保</view>
    <view class="banner-sub">智慧维保新模式</view>
    <button class="banner-scan" bindtap="onScanTap">📷 扫码签到</button>
  </view>

  <view class="home-body">
    <!-- 离线补传提示条（docs/03 §3.2 项2）：有待补传数据时常驻提醒，点击进离线缓存管理 -->
    <view wx:if="{{offlineCount > 0}}" class="offline-bar" bindtap="goOffline">
      ⚠️ 有 {{offlineCount}} 条离线数据待补传，点击查看
    </view>

    <!-- 今日待维保电梯 -->
    <view class="section-title">今日待维保电梯</view>
    <view class="stat-grid">
      <view class="stat-card stat-orange" data-due="today" bindtap="goStat">
        <view class="stat-num">{{summary.dueToday}} 台</view>
        <view class="stat-label">今日到期</view>
        <view class="stat-emoji">⏰</view>
      </view>
      <view class="stat-card stat-purple" data-due="soon" bindtap="goStat">
        <view class="stat-num">{{summary.dueSoon}} 台</view>
        <view class="stat-label">即将到期</view>
        <view class="stat-emoji">📣</view>
      </view>
      <view class="stat-card stat-red" data-due="overdue" bindtap="goStat">
        <view class="stat-num">{{summary.overdue}} 台</view>
        <view class="stat-label">保养超期</view>
        <view class="stat-emoji">🗓️</view>
      </view>
    </view>

    <!-- 维保记录情况 -->
    <view class="section-title">维保记录情况</view>
    <view wx:if="{{summary.warnCount > 0}}" class="warn-banner">
      🔊 您有 {{summary.warnCount}} 台电梯尚未达到无纸化维护保养要求，请核实！
    </view>
    <view class="record-grid">
      <view class="record-card" data-jump="inProgress" bindtap="goRecordCard">
        <view class="record-info">
          <view class="record-label">维保中</view>
          <view class="record-num num-green">{{summary.inProgress}} 份</view>
        </view>
        <view class="record-emoji bg-green">🛡️</view>
      </view>
      <view class="record-card" data-jump="unconfirmed" bindtap="goRecordCard">
        <view class="record-info">
          <view class="record-label">未确认</view>
          <view class="record-num num-blue">{{summary.unconfirmed}} 份</view>
        </view>
        <view class="record-emoji bg-blue">📝</view>
      </view>
    </view>

    <!-- 综合查询 -->
    <view class="section-title">综合查询</view>
    <view class="icon-grid">
      <view
        wx:for="{{queryMenus}}"
        wx:key="title"
        class="icon-item"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="onGridTap"
      >
        <view class="icon-box bg-{{item.color}}">{{item.icon}}</view>
        <view class="icon-label">{{item.title}}</view>
      </view>
    </view>

  </view>
</view>
