<view class="home-page">
  <!-- 顶部：到场签到记忆点（克制工业风：左对齐、个人问候 + 白底扫描主按钮） -->
  <view class="banner">
    <view class="banner-top">
      <view class="banner-greet">{{greeting}}</view>
      <view class="banner-role">{{roleText}}{{userInfo.groupName ? ' · ' + userInfo.groupName : ''}}</view>
    </view>
    <button class="banner-scan" bindtap="onScanTap">
      <view class="scan-glyph"></view>
      <view class="scan-text">
        <view class="scan-title">扫码到场签到</view>
        <view class="scan-sub">扫电梯二维码，记录到场时间与位置</view>
      </view>
      <view class="scan-arrow">›</view>
    </button>
  </view>

  <view class="home-body">
    <!-- 离线补传提示条（docs/03 §3.2 项2）：有待补传数据时常驻提醒，点击进离线缓存管理 -->
    <view wx:if="{{offlineCount > 0}}" class="offline-bar" bindtap="goOffline">
      <view class="offline-dot"></view>
      <view class="offline-text">有 {{offlineCount}} 条离线数据待补传</view>
      <view class="offline-arrow">›</view>
    </view>

    <!-- 到期提醒 -->
    <view class="section-title"><view class="section-bar"></view>到期提醒</view>
    <view class="stat-grid">
      <view class="stat-card stat-brand" data-due="today" bindtap="goStat">
        <view class="stat-num">{{summary.dueToday}}<text class="stat-unit">台</text></view>
        <view class="stat-label">今日到期</view>
      </view>
      <view class="stat-card stat-warning" data-due="soon" bindtap="goStat">
        <view class="stat-num">{{summary.dueSoon}}<text class="stat-unit">台</text></view>
        <view class="stat-label">即将到期</view>
      </view>
      <view class="stat-card stat-danger" data-due="overdue" bindtap="goStat">
        <view class="stat-num">{{summary.overdue}}<text class="stat-unit">台</text></view>
        <view class="stat-label">保养超期</view>
      </view>
    </view>

    <!-- 维保记录 -->
    <view class="section-title"><view class="section-bar"></view>维保记录</view>
    <view wx:if="{{summary.warnCount > 0}}" class="warn-banner">
      <view class="warn-dot"></view>
      <view class="warn-text">您有 {{summary.warnCount}} 台电梯未达无纸化维护保养要求</view>
    </view>
    <view class="record-grid">
      <view class="record-card" data-jump="inProgress" bindtap="goRecordCard">
        <view class="record-label">维保中</view>
        <view class="record-num num-green">{{summary.inProgress}}<text class="record-unit">份</text></view>
      </view>
      <view class="record-card" data-jump="unconfirmed" bindtap="goRecordCard">
        <view class="record-label">未确认</view>
        <view class="record-num num-blue">{{summary.unconfirmed}}<text class="record-unit">份</text></view>
      </view>
    </view>

    <!-- 综合查询 -->
    <view class="section-title"><view class="section-bar"></view>综合查询</view>
    <view class="icon-grid">
      <view
        wx:for="{{queryMenus}}"
        wx:key="title"
        class="icon-item"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="onGridTap"
      >
        <view class="icon-wrap">
          <view class="icon-glyph {{item.iconClass}}"></view>
          <view wx:if="{{item.badge > 0}}" class="icon-badge">{{item.badge}}</view>
        </view>
        <view class="icon-label">{{item.title}}</view>
      </view>
    </view>

  </view>
</view>
