.kb-input {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 16rpx 24rpx;
}

.kb-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kb-title {
  font-weight: 500;
  margin-right: 16rpx;
}

.kb-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--em-brand);
  background: var(--em-brand-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.kb-content {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--em-border);
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
}
