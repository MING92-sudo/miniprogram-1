page{background:var(--ink);color:var(--text)}
.fg-page{padding:24rpx 40rpx 32rpx;display:flex;flex-direction:column}
.fg-title{font-size:48rpx;line-height:1.2;margin-top:16rpx}
.fg-sub{margin-top:8rpx;line-height:1.6}
.fg-card{position:relative;margin-top:24rpx;border:1rpx solid #D9E0E6;border-radius:8rpx;padding:26rpx;background:#FFFFFF;overflow:hidden;box-shadow:0 16rpx 40rpx -28rpx rgba(23,36,45,.25)}
.fg-card::before{content:'';position:absolute;left:0;top:0;right:0;height:6rpx;background:repeating-linear-gradient(90deg,var(--amber) 0 24rpx,#17242D 24rpx 48rpx);opacity:.85}
.fg-input{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:20rpx 22rpx;font-size:26rpx;color:var(--text)}
.fg-ph{color:var(--dim)}
.fg-pw-wrap{position:relative}
.fg-pw{padding-right:96rpx}
.fg-eye{position:absolute;right:22rpx;top:50%;transform:translateY(-50%);color:var(--amber)}
.fg-submit{width:100%;margin-top:24rpx}
.fg-card .btn{width:100%;box-sizing:border-box}
.fg-note{margin-top:24rpx;border:1rpx dashed var(--line-2);border-radius:8rpx;padding:22rpx}
.fg-note-text{margin-top:8rpx;line-height:1.7}