<view class="bw">
  <nav-bar brand="{{true}}" back="{{false}}"></nav-bar>
  <view class="lg-page">
    <view class="lg-hero">
      <view class="row between">
        <text class="mono fs18 dim ls16">电梯维保数字化</text>
        <text class="mono fs18 dim">V1.3 · 2026</text>
      </view>
      <view class="lg-shaft" aria-hidden="true">
        <view class="lg-shaft-line" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
      </view>
      <view class="row gap10 lg-brandrow">
        <view class="brand-mark lg-mark"></view>
        <view>
          <view class="disp fs52">博威无纸化</view>
          <view class="mono fs18 dim ls16">电梯无纸化维保系统</view>
        </view>
      </view>
      <view class="disp lg-title"><text class="lg-title-line">让每一台电梯</text><text class="lg-title-line">都有据可查</text></view>
    </view>

    <view class="lg-hazard"></view>

    <view class="lg-card">
      <view class="row between">
        <text class="fs22 w6">登录工作台</text>
        <text class="mono fs18 dim ls12">统一入口</text>
      </view>
      <view class="col gap4 mt10">
        <text class="fs20 muted">账号</text>
        <input class="lg-input" value="{{phone}}" bindinput="onPhoneInput" placeholder="手机号 / 单位分配的账号" placeholder-class="lg-ph" />
      </view>
      <view class="col gap4 mt8">
        <text class="fs20 muted">密码</text>
        <view class="lg-pw-wrap">
          <input class="lg-input lg-pw" password="{{!showPassword}}" value="{{password}}" bindinput="onPasswordInput" placeholder="请输入密码" placeholder-class="lg-ph" />
          <text class="lg-eye fs20" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>
      <view class="row between mt8">
        <view class="row gap6" bindtap="toggleRemember">
          <view class="cb {{remember ? 'on' : ''}}"><text wx:if="{{remember}}" class="i i-check cb-ico"></text></view>
          <text class="fs20 dim">记住账号</text>
        </view>
        <text class="fs20 dim lg-forgot" bindtap="forgotPassword">忘记密码</text>
      </view>
      <button class="btn btn-primary lg-submit" disabled="{{logging}}" bindtap="onSubmit">{{logging ? '登录中…' : '登录工作台'}}</button>
      <button wx:if="{{wechatBound}}" class="btn btn-ghost lg-wechat" bindtap="onWechatLogin"><text class="i i-weixin"></text> 微信一键登录</button>
      <view class="row gap6 mt10" bindtap="toggleAgreed">
        <view class="cb {{agreed ? 'on' : ''}}"><text wx:if="{{agreed}}" class="i i-check cb-ico"></text></view>
        <text class="fs20 dim">已阅读并同意 <text class="lg-link" catchtap="openAgreement">《用户协议》</text> 与 <text class="lg-link" catchtap="openPrivacy">《隐私政策》</text></text>
      </view>
    </view>

    <view class="lg-points">
      <view><text class="i i-shield-halved"></text>电子签名固化</view>
      <view><text class="i i-cloud-arrow-up"></text>弱网自动续传</view>
      <view><text class="i i-clock-rotate-left"></text>作业全程留痕</view>
    </view>

    <view class="lg-foot">该小程序为重庆博威电梯公司内部相关人员登录使用，账号由单位管理员开通</view>
  </view>
</view>