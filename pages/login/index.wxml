<view class="bw">
  <nav-bar brand="{{true}}" back="{{false}}"></nav-bar>
  <view class="lg-page">
    <view class="lg-hero">
      <view class="row between">
        <text class="mono fs18 dim ls16">{{text.EYEBROW}}</text>
        <text class="mono fs18 dim">{{versionBadge}}</text>
      </view>
      <view class="lg-shaft" aria-hidden="true">
        <view class="lg-shaft-lines"></view>
        <text class="lg-floor" wx:for="{{text.FLOORS}}" wx:key="*this" style="top:{{52 + index * 80}}rpx">{{item}}</text>
        <view class="lg-rail"></view>
        <view class="lg-cable"></view>
        <view class="lg-car"></view>
        <view class="lg-dot"></view>
        <text class="lg-up">↑</text>
        <text class="lg-down">↓</text>
      </view>
      <view class="row gap10 lg-brandrow">
        <view class="brand-mark lg-mark"></view>
        <view>
          <view class="disp fs52">{{appName}}</view>
          <view class="mono fs18 dim ls16">{{text.BRAND_SUB}}</view>
        </view>
      </view>
      <view class="disp lg-title"><text class="lg-title-line">{{text.TITLE_1}}</text><text class="lg-title-line">{{text.TITLE_2}}</text></view>
    </view>

    <view class="lg-hazard"></view>

    <view class="lg-card">
      <view class="row between">
        <text class="fs22 w6">{{text.CARD_TITLE}}</text>
        <text class="mono fs18 dim ls12">{{text.CARD_TAG}}</text>
      </view>
      <view class="col gap4 mt10">
        <text class="fs20 muted">{{text.ACCOUNT}}</text>
        <input class="lg-input" value="{{phone}}" bindinput="onPhoneInput" placeholder="{{text.ACCOUNT_PH}}" placeholder-class="lg-ph" />
      </view>
      <view class="col gap4 mt8">
        <text class="fs20 muted">{{text.PASSWORD}}</text>
        <view class="lg-pw-wrap">
          <input class="lg-input lg-pw" password="{{!showPassword}}" value="{{password}}" bindinput="onPasswordInput" placeholder="{{text.PASSWORD_PH}}" placeholder-class="lg-ph" />
          <text class="lg-eye fs20" bindtap="togglePassword">{{showPassword ? text.HIDE : text.SHOW}}</text>
        </view>
      </view>
      <view class="row between mt8">
        <view class="row gap6" bindtap="toggleRemember">
          <view class="cb {{remember ? 'on' : ''}}"><text wx:if="{{remember}}" class="i i-check cb-ico"></text></view>
          <text class="fs20 dim">{{text.REMEMBER}}</text>
        </view>
        <text class="fs20 dim lg-forgot" bindtap="forgotPassword">{{text.FORGOT}}</text>
      </view>
      <button class="btn btn-primary lg-submit" disabled="{{logging}}" bindtap="onSubmit">{{logging ? text.SUBMITTING : text.SUBMIT}}</button>
      <button class="btn btn-ghost lg-wechat" disabled="{{logging}}" bindtap="onWechatLogin"><text class="i i-weixin"></text> {{text.WECHAT}}</button>
      <view class="col gap4 mt10">
        <view class="row gap6" bindtap="toggleAgreed">
          <view class="cb {{agreed ? 'on' : ''}}"><text wx:if="{{agreed}}" class="i i-check cb-ico"></text></view>
          <text class="fs20 dim">{{text.AGREE_PRE}}</text>
        </view>
        <view class="lg-agree-links">
          <view class="lg-agree-link" bindtap="openAgreement">《{{text.AGREEMENT}}》</view>
          <view class="lg-agree-link" bindtap="openPrivacy">《{{text.PRIVACY}}》</view>
        </view>
      </view>
    </view>

    <view class="lg-browse" bindtap="browseAsGuest">{{text.BROWSE}}</view>

    <view class="lg-points">
      <view wx:for="{{text.POINTS}}" wx:key="*this"><text class="i {{index === 0 ? 'i-shield-halved' : (index === 1 ? 'i-cloud-arrow-up' : 'i-clock-rotate-left')}}"></text>{{item}}</view>
    </view>

    <view class="week-strip lg-stats">
      <block wx:for="{{text.STATS}}" wx:key="label">
        <view wx:if="{{index > 0}}" class="vdiv"></view>
        <view><text class="mono fs32 {{item.tone}}">{{item.n}}</text><text class="fs18 dim">{{item.label}}</text></view>
      </block>
    </view>

    <view class="lg-foot">{{companyFoot}}</view>
  </view>
</view>
