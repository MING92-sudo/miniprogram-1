<view class="login-page">
  <view class="login-header">
    <view class="login-title">电梯无纸化维保</view>
    <view class="login-sub">维保记录电子化 · 对接监管平台</view>
    <view class="login-bar"></view>
  </view>

  <view class="form-area">
    <!-- 唯一登录入口：员工账号（手机号）与使用单位账号同一表单，后端按账号类型分流（docs/04 A.0.1） -->
    <view class="input-row">
      <input
        class="input-field"
        type="text"
        placeholder="请输入账号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="input-row">
      <input
        class="input-field"
        password="{{!showPassword}}"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <view class="eye" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
    </view>

    <view class="login-opts">
      <!-- 记住账号：仅本机存储，密码不落盘（docs/03 §5.6 / Minor5） -->
      <view class="remember" bindtap="toggleRemember">
        <view class="checkbox {{remember ? 'checked' : ''}}">{{remember ? '✓' : ''}}</view>
        <text class="remember-text">记住账号</text>
      </view>
      <view class="forgot" bindtap="forgotPassword">忘记密码？</view>
    </view>

    <view class="agreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgreed">{{agreed ? '✓' : ''}}</view>
      <view class="agreement-text">登录代表您已同意<text class="link" bindtap="openAgreement">《用户协议》</text>和<text class="link" bindtap="openPrivacy">《隐私政策》</text></view>
    </view>

    <button class="login-btn" disabled="{{logging}}" bindtap="onSubmit">
      {{logging ? '登录中...' : '立即登录'}}
      <text wx:if="{{!logging}}" class="login-arrow">→</text>
    </button>

    <!-- 微信一键登录：仅在「我的」页自行开启过绑定时出现，未开启不占位（用户需求） -->
    <view wx:if="{{wechatBound}}" class="skip-login" bindtap="onWechatLogin">微信一键登录</view>

    <view class="skip-login" bindtap="skipLogin">暂不登录，先看看</view>
  </view>
</view>
