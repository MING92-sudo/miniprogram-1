<view class="login-page">
  <!-- 装饰色块 -->
  <view class="deco deco-top"></view>
  <view class="deco deco-bottom-l"></view>
  <view class="deco deco-bottom-r"></view>

  <view class="login-header">
    <view class="login-title">电梯维保管家</view>
    <view class="login-sub">欢迎登录</view>
    <view class="login-bar"></view>
  </view>

  <view class="form-area">
    <view class="input-row">
      <text class="input-icon">📱</text>
      <view class="input-divider"></view>
      <input
        class="input-field"
        type="number"
        maxlength="11"
        placeholder="请输入账号（手机号）"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="input-row">
      <text class="input-icon">🔒</text>
      <view class="input-divider"></view>
      <input
        class="input-field"
        password="{{!showPassword}}"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <text class="eye" bindtap="togglePassword">👁</text>
    </view>
    <view class="forgot" bindtap="forgotPassword">忘记密码？</view>

    <button class="login-btn" disabled="{{logging}}" bindtap="onSubmit">
      {{logging ? '登录中...' : '立即登录'}}
      <text wx:if="{{!logging}}" class="login-arrow">→</text>
    </button>
  </view>

  <view class="agreement">
    <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgreed">{{agreed ? '✓' : ''}}</view>
    <view class="agreement-text">登录代表您已经同意<text class="link">《用户协议》</text>和<text class="link">《隐私政策》</text></view>
  </view>
</view>
