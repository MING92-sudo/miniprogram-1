page{background:var(--ink);color:var(--text)}
.lg-page{padding:24rpx 40rpx 32rpx;display:flex;flex-direction:column}
.lg-hero{position:relative;min-height:420rpx;padding-top:4rpx}
.lg-shaft{position:absolute;right:-28rpx;top:28rpx;width:248rpx;height:488rpx;opacity:.5;pointer-events:none;border:1rpx solid rgba(255,176,32,.18);display:flex;flex-direction:column;justify-content:space-around}
.lg-shaft-line{height:1rpx;background:rgba(255,176,32,.13)}
.lg-brandrow{margin-top:32rpx;position:relative;z-index:1}
.lg-mark{width:88rpx;height:88rpx;flex:none}
.lg-title{font-size:62rpx;line-height:1.14;letter-spacing:.02em;margin-top:44rpx;position:relative;z-index:1}
.lg-title-line{display:block}
.lg-sub{font-size:20rpx;color:var(--muted);line-height:1.75;max-width:400rpx;margin-top:18rpx;position:relative;z-index:1}
.lg-hazard{height:8rpx;border-radius:2rpx;background:repeating-linear-gradient(45deg,var(--amber) 0 18rpx,var(--ink) 18rpx 36rpx);opacity:.72;margin:24rpx 0}
.lg-card{position:relative;border:1rpx solid #2C3B42;border-radius:8rpx;padding:26rpx;background:linear-gradient(160deg,#162127,#0E171C);overflow:hidden;box-shadow:0 40rpx 80rpx -56rpx #000}
.lg-card::before{content:'';position:absolute;left:0;top:0;right:0;height:6rpx;background:repeating-linear-gradient(90deg,var(--amber) 0 24rpx,var(--ink) 24rpx 48rpx);opacity:.85}
.lg-input{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:20rpx 22rpx;font-size:26rpx;color:var(--text)}
.lg-ph{color:var(--dim)}
.lg-pw-wrap{position:relative}
.lg-pw{padding-right:96rpx}
.lg-eye{position:absolute;right:22rpx;top:50%;transform:translateY(-50%);color:var(--amber)}
.lg-submit{width:100%;margin-top:24rpx}
.lg-card .btn{width:100%;box-sizing:border-box}
.lg-wechat{width:100%;margin-top:14rpx;height:80rpx;font-size:24rpx}
.lg-link{color:#D6C29A}
.cb{width:28rpx;height:28rpx;border-radius:4rpx;border:1rpx solid var(--amber);display:flex;align-items:center;justify-content:center;flex:none}
.cb.on{background:var(--amber)}
.cb-ico{font-size:18rpx;color:#171005}
.lg-points{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:22rpx}
.lg-points view{display:flex;align-items:center;gap:8rpx;font-size:20rpx;color:var(--dim);white-space:nowrap}
.lg-points .i{color:var(--amber);font-size:18rpx}
.lg-roles{margin-top:32rpx;border-top:1rpx dashed var(--line-2);padding-top:22rpx}
.lg-role-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}
.lg-role{border:1rpx solid #243138;background:rgba(255,255,255,.02);border-radius:4rpx;padding:14rpx 8rpx;text-align:center;font-size:20rpx;color:#B9C7CC}
.lg-role .i{display:block;color:var(--amber);font-size:24rpx;margin-bottom:8rpx}
.lg-role-note{line-height:1.6;margin-top:16rpx}
.lg-foot{font-size:20rpx;color:var(--dim);text-align:center;line-height:1.6;margin-top:20rpx}
.lg-skip{margin:16rpx auto 0}