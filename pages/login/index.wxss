.login-page {
  min-height: 100vh;
  padding: 80rpx 48rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 64rpx;
}

.login-logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: var(--em-brand);
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.login-tip {
  text-align: center;
  margin-bottom: 32rpx;
}

.account-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--em-bg-card);
  border-radius: var(--em-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.account-card:active {
  background: var(--em-brand-light);
}

.account-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.account-arrow {
  color: var(--em-text-disabled);
  font-size: 48rpx;
}

.login-footer {
  text-align: center;
  margin-top: 48rpx;
}
