.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 140rpx 64rpx 60rpx;
  box-sizing: border-box;
  background: #ffffff;
}

/* ── 装饰色块 ── */
.deco {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(150deg, #69b1ff, #1668dc);
}

.deco-top {
  width: 420rpx;
  height: 420rpx;
  right: -160rpx;
  top: -180rpx;
}

.deco-bottom-l {
  width: 300rpx;
  height: 300rpx;
  left: -120rpx;
  bottom: -100rpx;
  border-radius: 40% 60% 55% 45%;
}

.deco-bottom-r {
  width: 140rpx;
  height: 140rpx;
  right: -40rpx;
  bottom: 140rpx;
  background: linear-gradient(150deg, #91caff, #4096ff);
}

/* ── 标题 ── */
.login-header {
  position: relative;
  margin-bottom: 100rpx;
}

.login-title {
  color: #1668dc;
  font-size: 52rpx;
  font-weight: 800;
}

.login-sub {
  color: #1d2129;
  font-size: 40rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.login-bar {
  width: 120rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4096ff, #69b1ff);
  margin-top: 28rpx;
}

/* ── 输入区 ── */
.form-area {
  position: relative;
}

.input-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e5e6eb;
  padding: 26rpx 4rpx;
}

.input-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.input-divider {
  width: 2rpx;
  height: 32rpx;
  background: #e5e6eb;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
}

.eye {
  font-size: 34rpx;
  padding: 0 8rpx;
}

.login-opts {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 24rpx;
}

.remember {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4e5969;
}

.checkbox {
  font-size: 30rpx;
  color: #0052d9;
}

.forgot {
  text-align: right;
  color: #1668dc;
  font-size: 26rpx;
  margin-top: 20rpx;
}

/* ── 登录按钮 ── */
.login-btn {
  margin-top: 72rpx;
  background: linear-gradient(90deg, #4096ff, #1668dc);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  line-height: 2.6;
}

.login-arrow {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
}

/* ── 协议 ── */
.agreement {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 120rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c9cdd4;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  text-align: center;
  line-height: 32rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #1668dc;
  border-color: #1668dc;
}

.agreement-text {
  font-size: 24rpx;
  color: #4e5969;
}

.link {
  color: #ff7d00;
}
