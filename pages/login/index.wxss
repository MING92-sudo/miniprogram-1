/* 登录页：克制工业风（白底 + 单蓝 + 下划线输入） */
.login-page {
  min-height: 100vh;
  padding: 120rpx 64rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--em-brand-light) 0%, #ffffff 360rpx);
}

/* ── 标题区 ── */
.login-header {
  margin-bottom: 80rpx;
}

.login-title {
  color: var(--em-text-primary);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.login-sub {
  color: var(--em-text-secondary);
  font-size: 28rpx;
  margin-top: 16rpx;
}

.login-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--em-brand);
  margin-top: 28rpx;
}

/* ── 输入区 ── */
.input-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--em-border);
  padding: 20rpx 0;
  min-height: 96rpx;
  box-sizing: border-box;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
}

/* 显示/隐藏密码（触控目标 ≥ 88rpx） */
.eye {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--em-brand);
  flex-shrink: 0;
}

/* ── 选项行 ── */
.login-opts {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 24rpx;
}

.remember {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 4rpx;
}

.remember-text {
  font-size: 26rpx;
  color: var(--em-text-secondary);
  margin-left: 12rpx;
}

.forgot {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 4rpx;
  color: var(--em-brand);
  font-size: 26rpx;
}

/* ── 登录按钮 ── */
.login-btn {
  margin-top: 8rpx;
  background: var(--em-brand);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  line-height: 2.8;
}
.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: var(--em-brand-light);
  color: var(--em-brand);
}

.login-arrow {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
}

/* ── 协议 ── */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 120rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--em-text-disabled);
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--em-brand);
  border-color: var(--em-brand);
}

.agreement-text {
  font-size: 24rpx;
  color: var(--em-text-secondary);
  margin-left: 12rpx;
}

.link {
  color: var(--em-brand);
}
