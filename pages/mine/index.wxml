<view class="em-page">
  <!-- 单身份登录：使用单位门户态与员工态互斥（登录任一方即清掉另一方），此处只会命中一个分支 -->
  <block wx:if="{{unitLogged}}">
    <view class="em-card unit-card">
      <view class="unit-title">使用单位门户</view>
      <view class="unit-name">{{unitName || '已登录'}}</view>
      <view class="unit-scope">仅可查看本单位电梯、维保记录与急修单，并报修</view>
      <view class="unit-actions">
        <button class="em-btn-primary unit-btn" bindtap="goUnitHome">进入门户</button>
        <button class="em-btn-ghost unit-btn" bindtap="logoutUnit">退出门户</button>
      </view>
      <!-- 微信免密登录（用户需求）：自行选择是否开启，未开启一律走账号口令 -->
      <view wx:if="{{!unitWechatBound}}" class="bind-box">
        <input
          class="bind-input"
          placeholder="输入邀请码"
          value="{{inviteCode}}"
          bindinput="onInviteInput"
        />
        <button class="em-btn-ghost bind-btn" disabled="{{binding}}" bindtap="onUnitWechatBind">
          {{binding ? '绑定中...' : '绑定微信'}}
        </button>
        <view class="em-text-secondary bind-tip">绑定后可在登录页用微信免密进入门户；邀请码由维保单位提供</view>
      </view>
      <view wx:else class="bind-state">微信已绑定，可用微信免密登录</view>
    </view>
    <view wx:if="{{versionText}}" class="em-text-secondary version-line">{{versionText}}</view>
  </block>

  <!-- 未登录：登录引导空状态（登录规范：先浏览功能，后自行选择登录） -->
  <view wx:elif="{{guest}}" class="guest-empty">
    <view class="guest-empty-title">登录后查看个人信息</view>
    <view class="guest-empty-sub">账号由本单位管理员统一分配</view>
    <button class="guest-empty-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="em-card user-card">
      <view class="avatar">{{userInfo.name ? userInfo.name[0] : '未'}}</view>
      <view class="user-main">
        <view class="user-name">{{userInfo.name || '未登录'}}</view>
        <view class="role-badge">{{roleText}}</view>
        <view wx:if="{{scopeText}}" class="scope-tip">{{scopeText}}</view>
      </view>
    </view>

    <!-- 证件到期提醒（docs/03 §3.2 项18） -->
    <view wx:if="{{certText}}" class="cert-tip cert-{{certLevel}}">{{certText}}</view>

    <view class="em-card">
      <view
        wx:for="{{menus}}"
        wx:key="url"
        class="menu-item"
        data-url="{{item.url}}"
        bindtap="onMenuTap"
      >
        <view class="menu-main">
          <view>{{item.title}}</view>
          <view class="em-text-secondary menu-desc">{{item.desc}}</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <!-- 微信一键登录（用户需求）：员工自行选择是否开启，未开启不强制、不影响账号密码登录 -->
      <view class="menu-item" bindtap="onBindWechat">
        <view class="menu-main">
          <view>微信一键登录</view>
          <view class="em-text-secondary menu-desc">{{wechatBound ? '已开启，可在登录页用微信免密登录' : '未开启，点击绑定当前微信'}}</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view class="em-card">
      <view class="menu-item logout" bindtap="onLogout">退出登录</view>
    </view>

    <view wx:if="{{versionText}}" class="em-text-secondary version-line">{{versionText}}</view>
  </block>
</view>
