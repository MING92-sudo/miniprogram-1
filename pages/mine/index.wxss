.cert-tip {
  margin: 0 20rpx 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cert-expired {
  background: var(--em-error-bg);
  color: var(--em-error);
}

.cert-soon {
  background: var(--em-warning-bg);
  color: var(--em-warning);
}

.cert-ok {
  background: var(--em-neutral-bg);
  color: var(--em-neutral);
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 32rpx;
}

.avatar {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--em-brand);
  color: #ffffff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 角色可见范围说明（docs/14 §7）：让管理员/商务一眼看出自己不是作业身份 */
.scope-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #86909c;
}

.role-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--em-brand);
  background: var(--em-brand-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--em-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.menu-arrow {
  color: var(--em-text-disabled);
  font-size: 40rpx;
}

.logout {
  color: var(--em-error);
  text-align: center;
  justify-content: center;
}
.version-line {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}

/* 使用单位门户卡片（W3）：门户登录态独立于员工登录态 */
.unit-card { margin-bottom: 20rpx; }
.unit-title { font-size: 28rpx; font-weight: 600; }
.unit-name { margin-top: 8rpx; font-size: 26rpx; color: #86909c; }
.unit-actions { margin-top: 16rpx; display: flex; gap: 16rpx; }
.unit-btn { flex: 1; }

/* 微信绑定（用户需求）：员工与使用单位各自可选，未开启不影响账号密码登录 */
.bind-box { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f2f3f5; }
.bind-input { height: 72rpx; padding: 0 20rpx; background: #f7f8fa; border-radius: 12rpx; font-size: 26rpx; }
.bind-btn { margin-top: 16rpx; }
.bind-tip { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; }
.bind-state { margin-top: 20rpx; font-size: 24rpx; color: #00b42a; }
.unit-scope { margin-top: 8rpx; font-size: 24rpx; color: #86909c; line-height: 1.6; }
