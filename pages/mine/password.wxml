<view class="page">
  <view class="card">
    <view class="tip">初始密码由管理员发放，首次登录后请在此修改；新密码至少 6 位。</view>
    <input class="ipt" password placeholder="原密码" value="{{oldPassword}}" bindinput="onOld" />
    <input class="ipt" password placeholder="新密码（至少 6 位）" value="{{newPassword}}" bindinput="onNew" />
    <input class="ipt" password placeholder="确认新密码" value="{{confirm}}" bindinput="onConfirm" />
    <button class="btn" disabled="{{submitting}}" bindtap="submit">保存新密码</button>
  </view>
</view>