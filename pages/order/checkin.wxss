.step-no {
  font-size: 22rpx;
  color: var(--em-brand);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.location-ok {
  color: var(--em-success);
  margin-bottom: 16rpx;
}

.location-fail {
  color: var(--em-danger, #e34d59);
  margin-bottom: 16rpx;
}

.role-row {
  display: flex;
  gap: 16rpx;
}

.role-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--em-radius);
  background: var(--em-bg-page);
  color: var(--em-text-secondary);
  border: 2rpx solid transparent;
}

.role-active {
  color: var(--em-brand);
  background: rgba(0, 82, 217, 0.06);
  border-color: var(--em-brand);
  font-weight: 600;
}

.code-wrap {
  margin-top: 20rpx;
}

.code-input {
  border: 2rpx solid var(--em-border, #e5e6eb);
  border-radius: var(--em-radius);
  padding: 16rpx 24rpx;
  margin-bottom: 12rpx;
}

.step-action {
  margin-top: 16rpx;
}

.photo-wrap {
  position: relative;
}

.photo-preview {
  width: 100%;
  height: 400rpx;
  border-radius: var(--em-radius);
}

.photo-remove {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: #000000a6;
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.photo-empty {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
}

.submit-tip {
  text-align: center;
  margin-top: 16rpx;
}
