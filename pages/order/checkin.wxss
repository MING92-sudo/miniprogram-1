.step-no {
  font-size: 22rpx;
  color: var(--em-brand);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.location-ok {
  color: var(--em-success);
  margin-bottom: 16rpx;
}

.step-action {
  margin-top: 16rpx;
}

.photo-wrap {
  position: relative;
}

.photo-preview {
  width: 100%;
  height: 400rpx;
  border-radius: var(--em-radius);
}

.photo-remove {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: #000000a6;
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.photo-empty {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
}

.submit-tip {
  text-align: center;
  margin-top: 16rpx;
}
