.head-card {
  text-align: center;
  padding: 40rpx 24rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--em-border);
}

.check-row:last-child {
  border-bottom: none;
}

.check-icon {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--em-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
}

.check-icon.checked {
  background: var(--em-success);
  border-color: var(--em-success);
}

.sig-preview {
  width: 100%;
  height: 280rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
}

.sig-empty {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
}

.sig-tip,
.submit-tip {
  margin-top: 16rpx;
  text-align: center;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-row text:first-child {
  color: var(--em-text-secondary);
}

.elapsed-ok {
  color: var(--em-success);
  font-weight: 600;
}

.elapsed-warn {
  color: var(--em-warning);
  font-weight: 600;
}

.duration-tip {
  margin-top: 8rpx;
}

.self-check {
  font-size: 28rpx;
  color: #1a1a1a;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.self-check-bad {
  color: #e34d59;
  background: #fdecec;
}
