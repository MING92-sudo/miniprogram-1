<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>

  <block wx:if="{{order}}">
    <view class="em-card">
      <view class="head-row">
        <view>
          <view class="order-no">{{order.orderNo}}</view>
          <view class="em-text-secondary">{{order.workType}} · 计划 {{order.planTime || '-'}}</view>
        </view>
        <view class="tag tag-{{order.status}}">{{statusText}}</view>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">电梯信息</view>
      <view class="info-row"><text>电梯名称</text><text>{{elevator.elevatorName || '-'}}</text></view>
      <view class="info-row"><text>电梯编号</text><text>{{elevator.elevatorCode || '-'}}</text></view>
      <view class="info-row"><text>电梯位置</text><text>{{elevator.location || '-'}}</text></view>
      <view class="info-row"><text>注册代码</text><text>{{elevator.regCode || '-'}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">作业信息</view>
      <view class="info-row"><text>维保人员</text><text>{{order.workerName || '-'}}</text></view>
      <view class="info-row"><text>配合人员</text><text>{{order.assistantName || '无'}}</text></view>
      <view class="info-row"><text>签到时间</text><text>{{order.checkinTime || '-'}}</text></view>
      <view class="info-row"><text>签退时间</text><text>{{order.checkoutTime || '-'}}</text></view>
    </view>

    <!-- 主维保与配合人员分别签到（docs/01 §3.7.2）：本人未签到即可签到，双人工单另提供动态码入口 -->
    <view class="em-card" wx:if="{{canCheckin}}">
      <button class="em-btn-primary" bindtap="goCheckin">{{isAssistant ? '配合人员签到' : '开始签到'}}</button>
      <view wx:if="{{isDual}}" class="sub-action" bindtap="goDynamicCode">
        {{isAssistant ? '已有主维保动态码？输入校验 ›' : '生成双人动态码（配合人员到场验证）›'}}
      </view>
    </view>

    <view class="em-card" wx:if="{{order.status === 'PROCESSING'}}">
      <button class="em-btn-primary" bindtap="goChecklist">继续作业清单</button>
      <view wx:if="{{myCheckedIn}}" class="em-text-secondary sub-action">本人已签到{{isDual ? '，配合人员可各自签到' : ''}}</view>
    </view>

    <view class="em-card" wx:if="{{order.status === 'DONE'}}">
      <view class="section-title">维保记录与上报</view>
      <view class="info-row"><text>作业时长</text><text>{{order.duration || '-'}}</text></view>
      <view class="info-row"><text>记录ID</text><text>{{order.originalRecordId || '-'}}</text></view>
      <view class="info-row"><text>上报状态</text><text class="report-status">{{reportStatusText || '未上报'}}</text></view>
      <view class="em-text-secondary record-tip">维保记录已生成（含平台 2.6 上报快照），确认结果不上报平台</view>
      <button wx:if="{{canReupload}}" size="mini" class="em-btn-primary" bindtap="retryReport">手动重报平台</button>
      <button wx:if="{{order.recordInfo && order.recordInfo.id}}" size="mini" class="em-btn-ghost" bindtap="goRecordPreview">查看完整记录单</button>
    </view>

    <!-- 完整维保记录（DONE） -->
    <block wx:if="{{order.status === 'DONE' && recordItems.length}}">
      <view class="em-card">
        <view class="section-title">作业内容与结果（{{recordItems.length}} 项）</view>
        <view wx:for="{{recordItems}}" wx:key="id" class="rec-item">
          <view class="rec-name">{{index + 1}}. {{item.name}}</view>
          <view class="rec-result rec-{{item.result}}">{{item.resultText}}</view>
          <view class="rec-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
        </view>
      </view>

      <view class="em-card" wx:if="{{recordPhotos.length}}">
        <view class="section-title">现场照片（{{recordPhotos.length}}）</view>
        <view class="rec-photo-grid">
          <image
            wx:for="{{recordPhotos}}"
            wx:key="*this"
            class="rec-photo"
            src="{{item}}"
            mode="aspectFill"
            data-src="{{item}}"
            bindtap="previewRecordPhoto"
          />
        </view>
      </view>

      <view class="em-card" wx:if="{{order.recordInfo}}">
        <view class="section-title">维保人员签字</view>
        <view class="rec-sig-row">
          <view class="rec-sig-cell">
            <view class="em-text-secondary">主维保：{{order.workerName || '-'}}</view>
            <image wx:if="{{order.recordInfo.workerSignatureUrl}}" class="rec-sig" src="{{order.recordInfo.workerSignatureUrl}}" mode="aspectFit" />
          </view>
          <view class="rec-sig-cell" wx:if="{{order.recordInfo.assistantSignatureUrl}}">
            <view class="em-text-secondary">配合人员：{{order.assistantName || '-'}}</view>
            <image class="rec-sig" src="{{order.recordInfo.assistantSignatureUrl}}" mode="aspectFit" />
          </view>
        </view>
        <view class="em-text-secondary rec-confirm" wx:if="{{order.recordInfo.confirmStatus}}">
          使用单位确认：{{order.recordInfo.confirmStatus === 'CONFIRMED' ? '已确认' : '待确认'}}{{order.recordInfo.satisfaction != null ? ' · 满意度 ' + order.recordInfo.satisfaction + ' 分' : ''}}
        </view>
        <view wx:if="{{order.recordInfo.confirmStatus !== 'CONFIRMED'}}" class="rec-actions">
          <button size="mini" class="em-btn-primary" bindtap="goSignConfirm">安全管理员签字确认</button>
          <view class="em-text-secondary rec-share-tip">可本机代签，或分享链接给安全管理员远程签字</view>
        </view>
      </view>
    </block>
  </block>
</view>
