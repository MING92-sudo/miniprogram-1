.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-no {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: var(--em-text-secondary);
}

.info-row text:first-child {
  color: var(--em-text-primary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-row text:last-child {
  text-align: right;
}

.tag {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
}

.tag-PENDING {
  color: var(--em-warning);
  background: #fdf6ec;
}

.tag-PROCESSING {
  color: var(--em-brand);
  background: var(--em-brand-light);
}

.tag-DONE {
  color: var(--em-success);
  background: #e8f7f0;
}

.sub-action {
  margin-top: 24rpx;
  text-align: center;
  color: var(--em-brand);
  font-size: 26rpx;
}

.done-tip {
  text-align: center;
}

.report-status {
  color: var(--em-success);
  font-weight: 600;
}

.record-tip {
  margin-top: 12rpx;
}
.rec-item {
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.rec-item:last-child {
  border-bottom: none;
}

.rec-name {
  font-size: 26rpx;
  font-weight: 500;
}

.rec-result {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 6rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.rec-NORMAL { color: #2ba471; background: rgba(43, 164, 113, 0.1); }
.rec-ABNORMAL { color: #e34d59; background: rgba(227, 77, 89, 0.1); }
.rec-NA { color: #86909c; background: rgba(134, 144, 156, 0.12); }

.rec-remark {
  font-size: 24rpx;
  color: var(--em-text-secondary, #86909c);
  margin-top: 6rpx;
}

.rec-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.rec-photo {
  width: 210rpx;
  height: 158rpx;
  border-radius: 12rpx;
  background: #eef1f6;
}

.rec-sig-row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.rec-sig-cell {
  flex: 1;
}

.rec-sig {
  width: 100%;
  height: 140rpx;
  margin-top: 10rpx;
  background: #f5f8fd;
  border-radius: 12rpx;
}

.rec-confirm {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.rec-actions {
  margin-top: 20rpx;
}

.rec-share-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}
