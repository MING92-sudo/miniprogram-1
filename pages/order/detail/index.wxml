<view class="bw">
  <nav-bar title="{{text.TITLE}}" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:160},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry" bind:back="onBack"></error-retry>
    <block wx:else>
      <view class="{{fault.rescue ? 'sos' : 'plate'}} col gap6">
        <view class="row between">
          <text class="tag {{fault.rescue ? 'tag-signal' : 'tag-amber'}}">{{fault.rescue ? 'P1 · 困人急修' : 'P2 · 急修'}} · {{statusText}}</text>
          <text class="mono fs18 dim">{{fault.id}}</text>
        </view>
        <view class="row between">
          <view class="disp fs40 grow">{{heroTitle}}</view>
          <view wx:if="{{responseText}}" class="right"><view class="mono fs38">{{responseText}}</view><view class="mono fs18 dim ls12">{{text.RESPONSE}}</view></view>
        </view>
        <view class="fs20 muted">{{heroSub}}</view>
      </view>

      <view wx:if="{{timeline.length}}" class="stepper">
        <block wx:for="{{timeline}}" wx:key="label">
          <view wx:if="{{index > 0}}" class="step-line done"></view>
          <view class="step {{item.tone === 'amber' ? 'active' : (item.tone === 'dim' ? '' : 'done')}}">
            <view class="dot"><text wx:if="{{item.tone === 'ok'}}" class="i i-check"></text><text wx:else>{{index + 1}}</text></view>
            <text>{{item.label}}</text>
            <text class="mono fs18 dim">{{item.time}}</text>
          </view>
        </block>
      </view>

      <view wx:if="{{!isClient && fault.status === 'ASSIGNED'}}" class="hint">已接工单，请到场后点击「到场签到」</view>

      <view class="card col gap6">
        <view class="sec-head"><text class="panel-title mono">{{text.FAULT}}</text><text wx:if="{{fault.status === 'CLOSED'}}" class="tag tag-ok">已恢复运行</text></view>
        <view class="kv-row"><text class="dim">{{text.FAULT_PHEN}}</text><text>{{fault.desc || '—'}}</text></view>
        <view wx:if="{{fault.trappedCount}}" class="kv-row"><text class="dim">{{text.FAULT_TRAPPED}}</text><text>{{fault.trappedCount}} {{text.TRAPPED_UNIT}}{{fault.rescuedAt ? ' · 安全救出' : ''}}</text></view>
        <view class="kv-row"><text class="dim">{{text.FAULT_SOURCE}}</text><text>{{sourceText}}</text></view>
        <view wx:if="{{fault.createdByName}}" class="kv-row"><text class="dim">{{text.FAULT_REPORTER}}</text><text>{{fault.createdByName}}</text></view>
        <view wx:if="{{fault.reporterPhone}}" class="kv-row" bindtap="onCallReporter">
          <text class="dim">{{text.FAULT_PHONE}}</text>
          <text class="link">{{fault.reporterPhone}}</text>
        </view>
      </view>

      <view wx:if="{{fault.handleDesc || fault.result}}" class="card col gap6">
        <view class="panel-title mono">{{text.REPAIR}}</view>
        <view class="fs22">{{fault.handleDesc || fault.result}}</view>
      </view>

      <view wx:if="{{fault.photos.length}}" class="photo-row">
        <image wx:for="{{fault.photos}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewPhoto"></image>
      </view>

      <view wx:if="{{!editable && fault.repairPhotos.length}}" class="card col gap6">
        <view class="panel-title">维修照片</view>
        <view class="od-photo-row">
          <image wx:for="{{fault.repairPhotos}}" wx:key="*this" class="od-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewRepairPhoto"></image>
        </view>
      </view>

      <view wx:if="{{fault.status === 'CLOSED'}}" class="sync-note">
        <text class="i i-file-signature"></text>
        <view class="grow"><view class="fs22 w6">{{text.CONFIRMED}}</view><view class="fs18 dim">{{fault.confirmedAt}} {{text.SIGNED}}</view></view>
        <text class="tag tag-ok">已闭环</text>
      </view>
      <view wx:if="{{fault.signature}}" class="paper">
        <view class="row between"><text class="fs20">{{text.SIGN_CLIENT}}</text><text class="fs18">{{text.SIGNED}} {{fault.confirmedAt}}</text></view>
        <image class="od-sign" src="{{fault.signature}}" mode="aspectFit"></image>
        <view class="row between fs18 dim"><text>{{fault.id}} · {{text.SIGN_NOTE}}</text><text>{{text.SIGN_GPS}}</text></view>
      </view>
      <view wx:if="{{!editable && fault.workerSignature}}" class="paper">
        <view class="row between"><text class="fs20">维保人员签字</text><text class="fs18">{{fault.finishedAt || ''}}</text></view>
        <image class="od-sign" src="{{fault.workerSignature}}" mode="aspectFit"></image>
      </view>

      <view class="card col gap6">
        <view class="panel-title">处置信息</view>
        <view class="kv-row"><text class="dim">现场情况</text><text>{{fault.siteDesc || '—'}}</text></view>
        <view class="kv-row"><text class="dim">待办事项</text><text>{{fault.todoDesc || '—'}}</text></view>
        <view wx:if="{{fault.cancelReason}}" class="kv-row"><text class="dim">取消原因</text><text>{{fault.cancelReason}}</text></view>
        <view wx:if="{{fault.refuseReason}}" class="kv-row"><text class="dim">拒绝原因</text><text>{{fault.refuseReason}}</text></view>
      </view>

      <view wx:if="{{editable}}" class="card col gap8">
        <view class="panel-title">维修过程</view>
        <textarea class="od-textarea" value="{{siteDesc}}" bindinput="onSiteInput" placeholder="现场情况（原因，必填）" placeholder-class="od-ph"></textarea>
        <textarea class="od-textarea" value="{{handleDesc}}" bindinput="onHandleInput" placeholder="处理结果（措施，必填）" placeholder-class="od-ph"></textarea>
        <textarea class="od-textarea" value="{{todoDesc}}" bindinput="onTodoInput" placeholder="待办事项（留空视为无）" placeholder-class="od-ph"></textarea>

        <view class="panel-title mt8">维修照片</view>
        <view class="od-photo-row">
          <view wx:for="{{repairPhotos}}" wx:key="*this" class="od-photo-wrap">
            <image class="od-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewRepairPhoto"></image>
            <text class="od-photo-del" data-url="{{item}}" catchtap="onRemoveRepairPhoto"><text class="i i-xmark fs18"></text></text>
          </view>
          <view wx:if="{{repairPhotos.length < 6}}" class="od-photo-add" bindtap="onAddRepairPhoto" aria-role="button"><text class="i i-camera"></text></view>
        </view>

        <view class="panel-title mt8">维保人员签字</view>
        <view wx:if="{{workerSignature}}" class="od-sign-wrap">
          <image class="od-worker-sign" src="{{workerSignature}}" mode="aspectFit"></image>
          <button class="link" bindtap="onSignWorker">重新签字</button>
        </view>
        <button wx:else class="btn btn-ghost" bindtap="onSignWorker">点击签字</button>

        <view class="row gap8">
          <button class="btn btn-ghost grow" disabled="{{submitting}}" bindtap="onSaveProcess">保存过程</button>
          <button class="btn btn-primary grow" bindtap="onSubmitFault">提交急修单</button>
        </view>
      </view>

    </block>
  </view>
  <view class="page-footer" wx:if="{{!loading && !error && fault}}">
    <button wx:if="{{canCancel}}" class="btn btn-ghost od-f-ghost" bindtap="onCancel">{{text.CANCEL}}</button>
    <button wx:if="{{!isClient && fault.status === 'OPEN'}}" class="btn btn-primary od-f-main" bindtap="onGrab"><text class="i i-bolt"></text> {{text.GRAB}}</button>
    <button wx:if="{{!isClient && fault.status === 'ASSIGNED'}}" class="btn btn-primary od-f-main" bindtap="onArrive"><text class="i i-location-dot"></text> {{text.ARRIVE}}</button>
    <block wx:if="{{fault.status === 'PENDING_CONFIRM' && canConfirm}}">
      <button class="btn btn-ghost od-f-ghost" data-pass="false" bindtap="onConfirm">拒绝并说明</button>
      <button class="btn btn-primary od-f-main" data-pass="true" bindtap="onConfirm">{{text.CONFIRM}}</button>
    </block>
  </view>
</view>
