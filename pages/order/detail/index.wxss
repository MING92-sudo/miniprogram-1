.od-sign{width:100%;height:120rpx;margin:12rpx 0}
.od-textarea{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:14rpx;font-size:22rpx;color:var(--text);min-height:90rpx;width:100%;box-sizing:border-box}
.od-ph{color:var(--dim)}
.od-photo-row{display:flex;flex-wrap:wrap;gap:12rpx}
.od-photo-wrap{position:relative;width:120rpx;height:120rpx}
.od-photo{width:120rpx;height:120rpx;border-radius:8rpx;background:#F2F5F7}
.od-photo-del{position:absolute;top:-8rpx;right:-8rpx;width:34rpx;height:34rpx;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;display:flex;align-items:center;justify-content:center}
.od-photo-add{width:120rpx;height:120rpx;border:1rpx dashed #C9D3DA;border-radius:8rpx;display:flex;align-items:center;justify-content:center;color:var(--dim);background:#F7F9FA}
.od-sign-wrap{display:flex;flex-direction:column;gap:8rpx;align-items:flex-start}
.od-worker-sign{width:100%;height:140rpx;background:#fff;border:1rpx solid var(--line);border-radius:6rpx}
.od-f-ghost{flex:.9}
.od-f-main{flex:1.1}
.page-pad{padding-bottom:calc(160rpx + env(safe-area-inset-bottom,0px))}
