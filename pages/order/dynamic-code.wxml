<view class="em-page">
  <view class="em-card">
    <view class="tip">请向配合维保人员索取动态码并输入</view>
    <input
      class="code-input"
      type="number"
      maxlength="6"
      placeholder="请输入 6 位动态码"
      value="{{code}}"
      bindinput="onCodeInput"
    />
    <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">确认校验</button>
  </view>
</view>
