<view class="em-page">
  <view class="em-card">
    <view class="mode-row">
      <view class="mode-item {{mode === 'ISSUE' ? 'mode-active' : ''}}" data-mode="ISSUE" bindtap="switchMode">我是主维保（生成码）</view>
      <view class="mode-item {{mode === 'INPUT' ? 'mode-active' : ''}}" data-mode="INPUT" bindtap="switchMode">我是配合人员（输入码）</view>
    </view>

    <block wx:if="{{mode === 'ISSUE'}}">
      <view class="tip">请让配合维保人员当面输入以下动态码，验证同时到场</view>
      <view class="code-display">{{code || '------'}}</view>
      <view class="em-text-secondary code-meta">
        {{countdown}} 秒后自动刷新 · 单码有效期 {{ttlSeconds}} 秒{{expiresAt ? ' · 本码至 ' + expiresAt : ''}}
      </view>
      <view wx:if="{{errorText}}" class="code-error">{{errorText}}</view>
      <view class="em-text-secondary code-tip">动态码与本工单绑定，配合人员签到成功后即失效（不可重放）</view>
    </block>

    <block wx:elif="{{mode === 'INPUT'}}">
      <view class="tip">请向主维保人员索取当屏动态码并输入</view>
      <input
        class="code-input"
        type="number"
        maxlength="6"
        placeholder="请输入 6 位动态码"
        value="{{inputCode}}"
        bindinput="onCodeInput"
      />
      <view wx:if="{{errorText}}" class="code-error">{{errorText}}</view>
      <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">
        {{submitting ? '校验中...' : '确认校验并签到'}}
      </button>
      <view class="em-text-secondary code-tip">校验不通过可重试（已裁 3 次失败锁定，docs/01 §10.2）</view>
    </block>

    <view wx:else class="em-text-secondary">正在识别您的作业角色...</view>
  </view>
</view>
