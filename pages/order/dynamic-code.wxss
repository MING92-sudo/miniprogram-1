.tip {
  color: var(--em-text-secondary);
  margin-bottom: 24rpx;
}

.code-input {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
  text-align: center;
  letter-spacing: 12rpx;
}

/* 角色切换（主维保生成 / 配合人员输入） */
.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--em-radius);
  background: var(--em-bg-page);
  color: var(--em-text-secondary);
  font-size: 26rpx;
}

.mode-active {
  background: var(--em-primary, #0052d9);
  color: #fff;
}

.code-display {
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  text-align: center;
  color: var(--em-primary, #0052d9);
  margin: 16rpx 0 8rpx;
}

.code-meta {
  text-align: center;
  margin-bottom: 16rpx;
}

.code-error {
  color: #d54941;
  text-align: center;
  margin-bottom: 16rpx;
}

.code-tip {
  margin-top: 16rpx;
  text-align: center;
}
