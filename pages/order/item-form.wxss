.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
}

.key-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--em-error);
  background: #fdecec;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.item-meta {
  margin-bottom: 24rpx;
}

.form-label {
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.result-options {
  display: flex;
  gap: 20rpx;
}

.option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--em-radius);
  background: var(--em-bg-page);
}

.opt-ok {
  background: #e8f7f0;
  color: var(--em-success);
  font-weight: 600;
}

.opt-ng {
  background: #fdecec;
  color: var(--em-error);
  font-weight: 600;
}

.opt-na {
  background: #eeeeee;
  color: var(--em-text-secondary);
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.read-input {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 16rpx 20rpx;
}

.read-tip {
  margin-top: 12rpx;
}

.picker-value {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.picker-value.placeholder {
  color: var(--em-text-disabled);
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--em-radius);
  background: var(--em-bg-page);
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #000000cc;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--em-text-disabled);
}
