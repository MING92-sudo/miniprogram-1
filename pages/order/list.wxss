/* 工单页：单蓝页头 + 电梯信息卡 */
.wo-page {
  min-height: 100vh;
  background: var(--em-bg-page);
  padding-bottom: 40rpx;
}

/* ── 蓝色页头 ── */
.wo-header {
  background: var(--em-brand);
  padding: 32rpx 24rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.wo-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 28rpx;
}

.wo-search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.wo-search {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}

.wo-search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--em-text-primary);
}

.wo-scan {
  font-size: 26rpx;
  color: #ffffff;
  flex-shrink: 0;
}

/* ── 过滤提示 ── */
.due-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--em-warning);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  margin: 20rpx 24rpx 0;
}

.due-clear {
  color: var(--em-brand);
}

/* ── 状态 tabs ── */
.wo-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 8rpx;
}

.wo-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--em-text-secondary);
  padding: 0;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
}

.wo-tab-active {
  color: var(--em-brand);
  font-weight: 600;
  background: var(--em-brand-light);
}

/* ── 工单卡片 ── */
.wo-list {
  padding: 20rpx 24rpx 0;
}

.wo-empty {
  text-align: center;
  color: var(--em-text-secondary);
}

.wo-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(10, 91, 211, 0.06);
}

.wo-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.wo-type-tag {
  background: var(--em-brand-light);
  color: var(--em-brand);
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
}

/* 状态胶囊：色点 + 文字（三编码，杜绝仅颜色） */
.wo-status {
  margin-left: auto;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.wo-status::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-PENDING { color: var(--em-warning); background: var(--em-warning-bg); }
.status-PROCESSING { color: var(--em-brand); background: var(--em-brand-light); }
.status-DONE { color: var(--em-success); background: var(--em-success-bg); }

/* ── 信息区 ── */
.wo-info {
  background: var(--em-bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--em-text-secondary);
  line-height: 1.9;
}

.wo-info-row {
  display: flex;
  flex-wrap: wrap;
}

.wo-info-cell {
  width: 50%;
}

.wo-strong {
  color: var(--em-text-primary);
  font-weight: 600;
}

/* ── 按钮 ── */
.wo-btns {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.wo-btn {
  font-size: 26rpx;
  padding: 0 36rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.wo-btn-ghost {
  color: var(--em-brand);
  border: 2rpx solid var(--em-brand);
  background: var(--em-brand-light);
}

.wo-btn-primary {
  color: #ffffff;
  background: var(--em-brand);
}
