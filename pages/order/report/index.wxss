page{background:var(--ink);color:var(--text)}
.rp-input{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:18rpx 20rpx;font-size:24rpx;color:var(--text)}
.rp-ph{color:var(--dim)}
.rp-textarea{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:18rpx;font-size:24rpx;color:var(--text);min-height:160rpx;width:100%}
.rp-photo-wrap{position:relative}
.rp-photo-del{position:absolute;top:-12rpx;right:-12rpx;width:36rpx;height:36rpx;border-radius:50%;background:var(--signal);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:20rpx}
.rp-photo-add{display:flex;align-items:center;justify-content:center;border:1rpx dashed #40535C;background:rgba(255,255,255,.02);color:var(--amber);font-size:32rpx}