page{background:var(--ink);color:var(--text)}
.rp-input{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:18rpx 20rpx;font-size:24rpx;color:var(--text)}
.rp-elevator-row{align-items:center}
.rp-elevator-row .grow{min-width:0}
.rp-picker{min-width:0}
.rp-select{display:flex;align-items:center;box-sizing:border-box;min-height:76rpx}
.rp-scan-btn{flex:0 0 136rpx;box-sizing:border-box;min-width:136rpx;height:76rpx;padding:0 16rpx;white-space:nowrap;line-height:1.2}
.rp-error{color:var(--signal)}
.rp-ph{color:var(--dim)}
.rp-textarea{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:18rpx;font-size:24rpx;color:var(--text);min-height:160rpx;width:100%}
.rp-photo-wrap{position:relative}
.rp-photo-del{position:absolute;top:-12rpx;right:-12rpx;width:36rpx;height:36rpx;border-radius:50%;background:var(--signal);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:20rpx}
.rp-photo-add{display:flex;align-items:center;justify-content:center;border:1rpx dashed #B7C3CB;background:rgba(23,36,45,.02);color:var(--amber);font-size:32rpx}.page-pad{padding-bottom:calc(160rpx + env(safe-area-inset-bottom,0px))}
.co-f-main{flex:1}
