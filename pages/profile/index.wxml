<view class="bw">
  <nav-bar title="{{text.TITLE}}" back="{{false}}"></nav-bar>
  <view class="page-pad tabbar-pad col gap10">
    <view class="card pf-id">
      <view class="row gap10">
        <view class="pf-avatar"><text>{{avatarChar}}</text></view>
        <view class="grow">
          <view class="disp fs38">{{userInfo.name || '未登录'}}</view>
          <view class="fs20 muted mt2">{{userInfo.unitName || userInfo.groupName || ''}}{{userInfo.jobTitle ? ' · ' + userInfo.jobTitle : ''}}{{userInfo.jobNo ? ' · ' + userInfo.jobNo : ''}}</view>
          <view wx:if="{{maskedPhone}}" class="fs20 dim mt2">手机号 {{maskedPhone}}{{text.MASKED_PHONE}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row between pf-sec">
        <text class="panel-title mono">{{text.ROLES}}</text>
        <text class="fs18 dim">{{text.ROLES_SUB}}</text>
      </view>
      <view class="pf-role mt8" wx:for="{{roleList}}" wx:key="code">
        <view class="grow">
          <view class="fs24 w6">{{item.name}}</view>
          <view class="fs18 dim mt2">{{item.code}}{{item.desc ? ' · ' + item.desc : ''}}</view>
        </view>
        <text class="tag {{item.current ? 'tag-ok' : 'tag-amber'}}">{{item.current ? text.CURRENT : text.DUAL}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row between pf-sec">
        <text class="panel-title mono">{{text.WORKBENCH}}</text>
        <text class="fs18 dim">{{text.WORKBENCH_SUB}}</text>
      </view>
      <view class="pf-ws-row mt8 {{item.state}}" wx:for="{{workbenchList}}" wx:key="key" data-ws="{{item.ws}}" data-state="{{item.state}}" bindtap="onSwitchWs">
        <text class="i i-{{item.icon}} pf-ws-ico"></text>
        <text class="grow fs24">{{item.label}}</text>
        <text wx:if="{{item.state === 'current'}}" class="tag tag-ok">{{text.CURRENT}}</text>
        <text wx:elif="{{item.state === 'none'}}" class="fs18 dim">{{text.NO_PERM}}</text>
        <text wx:else class="i i-chevron-right dim"></text>
      </view>
      <view wx:if="{{workbenchList.length > 1}}" class="pf-note mt8"><text class="i i-circle-info"></text> {{text.NOTE}}</view>
    </view>

    <view class="card pf-entries">
      <view class="pf-entry" bindtap="goMaskDoc"><text class="i i-eye-slash pf-eico"></text><text class="grow">{{text.MASK}}</text><text class="i i-chevron-right dim"></text></view>
      <view class="pf-entry" bindtap="goMessage"><text class="i i-bell-r pf-eico"></text><text class="grow">{{text.MESSAGE}}</text><text class="i i-chevron-right dim"></text></view>
      <view wx:if="{{!customer}}" class="pf-entry" bindtap="goOffline"><text class="i i-cloud-arrow-up pf-eico"></text><text class="grow">{{text.OFFLINE}}</text><text class="i i-chevron-right dim"></text></view>
      <view class="pf-entry" bindtap="goPassword"><text class="i i-key pf-eico"></text><text class="grow">{{text.PASSWORD}}</text><text class="i i-chevron-right dim"></text></view>
      <view class="pf-entry" bindtap="onBindWechat"><text class="i i-weixin pf-eico"></text><text class="grow">{{text.WECHAT}}{{wechatBound ? text.WECHAT_BOUND : ''}}</text><text class="i i-chevron-right dim"></text></view>
    </view>

    <view wx:if="{{adminEntries.length}}" class="card pf-entries">
      <view class="panel-title">{{text.ADMIN}}</view>
      <view wx:for="{{adminEntries}}" wx:key="key" class="pf-entry" data-path="{{item.path}}" bindtap="goAdminEntry">
        <text class="i i-building pf-eico"></text><text class="grow">{{item.text}}</text><text class="i i-chevron-right dim"></text>
      </view>
    </view>

    <view class="card pf-entries">
      <view class="pf-entry"><text class="i i-circle-info pf-eico"></text><text class="grow">{{text.ABOUT}}</text><text class="fs18 dim">{{versionText}}</text></view>
    </view>

    <button class="btn btn-ghost" bindtap="onLogout">{{text.LOGOUT}}</button>

    <view class="pf-attr">
      <view>图标：Font Awesome Free（CC BY 4.0）</view>
      <view>显示字：ZCOOL QingKe HuangYou（OFL 1.1）</view>
      <view class="mt4">{{appName}} · {{versionText}}</view>
    </view>
  </view>
  <custom-tabbar></custom-tabbar>
</view>
