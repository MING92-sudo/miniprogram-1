<view class="bw">
  <nav-bar title="修改密码" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <view class="card col gap8">
      <view class="fs22 w6">账号安全</view>
      <view class="fs20 dim">随机初始密码首次登录后请及时修改；新密码至少 6 位。</view>
    </view>
    <view class="card col gap10">
      <view class="col gap4">
        <text class="fs20 muted">原密码</text>
        <input class="pw-input" password value="{{oldPassword}}" bindinput="onOld" placeholder="请输入原密码" placeholder-class="pw-ph" />
      </view>
      <view class="col gap4">
        <text class="fs20 muted">新密码</text>
        <input class="pw-input" password value="{{newPassword}}" bindinput="onNew" placeholder="至少 6 位" placeholder-class="pw-ph" />
      </view>
      <view class="col gap4">
        <text class="fs20 muted">确认新密码</text>
        <input class="pw-input" password value="{{confirm}}" bindinput="onConfirm" placeholder="再次输入新密码" placeholder-class="pw-ph" />
      </view>
    </view>
    <button class="btn btn-primary" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : '确认修改'}}</button>
  </view>
</view>