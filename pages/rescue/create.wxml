<view class="em-page">
  <view class="em-card">
    <view class="form-label">电梯编号（可扫码）</view>
    <view class="code-row">
      <input class="form-input code-input" value="{{elevatorCode}}" bindinput="onCodeInput" placeholder="电梯编号" />
      <view class="scan-btn" bindtap="onScan">扫码</view>
    </view>

    <view class="form-label">被困人数</view>
    <input class="form-input" type="number" value="{{trappedCount}}" bindinput="onCountInput" placeholder="被困人数" />

    <view class="form-label">情况描述</view>
    <textarea class="form-textarea" value="{{desc}}" bindinput="onDescInput" maxlength="500" placeholder="现场情况描述" />

    <view class="form-label">救援节点（接警→抵达法定时限 ≤30 分钟）</view>
    <view class="time-row">
      <view class="time-cell">
        <view class="em-text-secondary">接警时间</view>
        <picker mode="time" value="{{alarmTime}}" data-field="alarmTime" bindchange="onTimeChange">
          <view class="form-input">{{alarmTime || '请选择'}}</view>
        </picker>
      </view>
      <view class="time-cell">
        <view class="em-text-secondary">出动时间</view>
        <picker mode="time" value="{{departTime}}" data-field="departTime" bindchange="onTimeChange">
          <view class="form-input">{{departTime || '请选择'}}</view>
        </picker>
      </view>
    </view>
    <view class="time-row">
      <view class="time-cell">
        <view class="em-text-secondary">抵达时间</view>
        <picker mode="time" value="{{arriveTime}}" data-field="arriveTime" bindchange="onTimeChange">
          <view class="form-input">{{arriveTime || '请选择'}}</view>
        </picker>
      </view>
      <view class="time-cell">
        <view class="em-text-secondary">解救时间</view>
        <picker mode="time" value="{{rescuedTime}}" data-field="rescuedTime" bindchange="onTimeChange">
          <view class="form-input">{{rescuedTime || '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-label">故障原因</view>
    <input class="form-input" value="{{reason}}" bindinput="onReasonInput" placeholder="如：门锁回路故障" />

    <view class="form-label">处置措施</view>
    <textarea class="form-textarea" value="{{action}}" bindinput="onActionInput" maxlength="300" placeholder="现场处置措施" />
  </view>

  <view class="em-card">
    <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">提交登记</button>
  </view>
</view>
