.form-label {
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input,
.form-textarea {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 160rpx;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
}

.scan-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: var(--em-radius);
  background: var(--em-brand-light);
  color: var(--em-brand);
  font-size: 26rpx;
}
.time-row {
  display: flex;
  gap: 16rpx;
}

.time-cell {
  flex: 1;
}

.form-label {
  margin-top: 20rpx;
}
