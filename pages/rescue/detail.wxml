<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>

  <block wx:if="{{record}}">
    <view class="em-card">
      <view class="head-row">
        <view class="rescue-title">{{record.elevatorCode || '救援记录'}}</view>
        <view class="tag tag-{{record.status === '已解除' ? 'DONE' : 'PROCESSING'}}">{{record.status}}</view>
      </view>
      <view wx:if="{{record.overtime}}" class="overtime-tag">⚠ 抵达超 30 分钟（法定时限），记录不可删除</view>
      <view wx:elif="{{record.arriveMinutes != null}}" class="ontime-tag">✓ 抵达 {{record.arriveMinutes}} 分钟，符合 30 分钟法定时限</view>
    </view>

    <view class="em-card">
      <view class="section-title">救援信息</view>
      <view class="info-row"><text>被困人数</text><text>{{record.trappedCount || 0}} 人</text></view>
      <view class="info-row"><text>登记时间</text><text>{{record.createdAt || '-'}}</text></view>
      <view class="info-row"><text>状态</text><text>{{record.status || '-'}}</text></view>
    </view>

    <view class="em-card" wx:if="{{record.alarmAt}}">
      <view class="section-title">救援节点留痕（自动计时）</view>
      <view class="info-row"><text>接警</text><text>{{record.alarmAt || '-'}}</text></view>
      <view class="info-row"><text>出动</text><text>{{record.departAt || '-'}}</text></view>
      <view class="info-row">
        <text>抵达</text>
        <text class="{{record.overtime ? 'node-overtime' : ''}}">{{record.arriveAt || '-'}}（{{record.arriveMinutes != null ? record.arriveMinutes + ' 分钟' : '-'}}）</text>
      </view>
      <view class="info-row"><text>解救</text><text>{{record.rescuedAt || '-'}}{{record.rescuedMinutes != null ? '（全程 ' + record.rescuedMinutes + ' 分钟）' : ''}}</text></view>
    </view>

    <view class="em-card" wx:if="{{record.reason || record.action}}">
      <view class="section-title">故障与处置</view>
      <view class="info-row" wx:if="{{record.reason}}"><text>故障原因</text><text>{{record.reason}}</text></view>
      <view class="info-row" wx:if="{{record.action}}"><text>处置措施</text><text>{{record.action}}</text></view>
    </view>

    <view class="em-card" wx:if="{{record.desc}}">
      <view class="section-title">情况描述</view>
      <view class="em-text-secondary">{{record.desc}}</view>
    </view>
  </block>
</view>
