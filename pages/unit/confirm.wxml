<view class="em-page">
  <view class="em-card">
    <view class="form-label">满意度评价</view>
    <view class="stars">
      <view
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="star {{satisfaction >= item ? 'star-active' : ''}}"
        data-value="{{item}}"
        bindtap="onSatisfaction"
      >★</view>
    </view>
  </view>

  <view class="em-card">
    <view class="form-label">安全管理人员签名</view>
    <view wx:if="{{signature}}" class="em-text-secondary">已完成签名</view>
    <button size="mini" bindtap="goSignature">去签名</button>
  </view>

  <view class="em-card">
    <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">确认提交</button>
  </view>
</view>
