<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>

  <view wx:if="{{failed}}" class="em-card">
    <view class="em-text-secondary">急修记录暂不可用，请稍后重试</view>
    <button class="em-btn-ghost retry" bindtap="onRetry">重试</button>
  </view>

  <view wx:if="{{!loading && !failed && !list.length}}" class="em-card em-text-secondary">{{text.EMPTY_FAULT}}</view>

  <view wx:for="{{list}}" wx:key="id" class="em-card">
    <view class="row-head">
      <text class="row-no">{{item.faultNo || item.id}}</text>
      <text class="tag {{item.closed ? 'is-ok' : 'is-todo'}}">{{item.statusText}}</text>
    </view>
    <view class="row-title">{{item.elevatorCode || '-'}} · {{item.faultType || '一般故障'}}</view>
    <view class="row-desc">{{item.desc || '-'}}</view>
    <view class="info-row"><text>报修时间</text><text>{{item.createdAt || '-'}}</text></view>
    <view class="info-row" wx:if="{{item.finishedAt}}"><text>闭环时间</text><text>{{item.finishedAt}}</text></view>
    <view class="info-row" wx:if="{{item.result}}"><text>处理结果</text><text>{{item.result}}</text></view>
  </view>

  <view class="em-card">
    <button class="em-btn-primary" bindtap="goReport">报修</button>
  </view>
</view>
