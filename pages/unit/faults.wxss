.row-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.row-no {
  font-size: 28rpx;
  font-weight: 600;
}

.row-title {
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.row-desc {
  font-size: 26rpx;
  color: var(--em-text-secondary);
  margin-bottom: 8rpx;
}

.tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
}

.tag.is-ok {
  color: var(--em-success);
  background: var(--em-success-bg);
}

.tag.is-todo {
  color: var(--em-warning);
  background: var(--em-warning-bg);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  color: var(--em-text-secondary);
  font-size: 26rpx;
}

.info-row text:first-child {
  color: var(--em-text-primary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-row text:last-child {
  text-align: right;
}

.em-btn-ghost {
  margin-top: 16rpx;
  background: var(--em-brand-light);
  color: var(--em-brand);
  border-radius: var(--em-radius);
}

.retry {
  margin-top: 16rpx;
}
