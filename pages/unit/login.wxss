.portal-head {
  padding: 64rpx 40rpx 8rpx;
}

.portal-title {
  font-size: 40rpx;
  font-weight: 600;
}

.portal-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--em-text-secondary);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
}

.login-btn {
  margin-top: 32rpx;
}

.em-btn-ghost {
  margin-top: 24rpx;
  background: var(--em-brand-light);
  color: var(--em-brand);
  border-radius: var(--em-radius);
}

/* 微信一键登录：绑过邀请码的账号免密进入 */
.wx-login-btn {
  margin-top: 16rpx;
}
