<view class="em-page unit-mine">
  <!-- 单位身份卡：与门户首页同一套品牌色头部 -->
  <view class="hero">
    <view class="hero-kicker">使用单位</view>
    <view class="hero-title">{{unitName || '使用单位'}}</view>
    <view class="hero-meta">
      <text wx:if="{{account}}">账号 {{account}}</text>
      <text wx:if="{{account}}" class="meta-dot">·</text>
      <text>安全管理员</text>
    </view>
    <button class="hero-btn" bindtap="goPortal">进入门户</button>
  </view>

  <view class="section-note">{{text.READONLY_TIP}}</view>

  <!-- 设置项：微信一键登录（可选） -->
  <view class="panel">
    <view class="panel-head">
      <view class="panel-title">微信一键登录</view>
      <view class="panel-state {{wechatBound ? 'state-on' : ''}}">{{wechatBound ? '已开启' : '未开启'}}</view>
    </view>
    <view wx:if="{{wechatBound}}" class="panel-desc">已绑定当前微信，可在登录页用微信免密进入门户。</view>
    <block wx:else>
      <view class="panel-desc">开启后无需输入账号口令即可进入门户；邀请码由维保单位提供。</view>
      <view class="field-row">
        <input
          class="field-input"
          placeholder="输入邀请码"
          value="{{inviteCode}}"
          bindinput="onInviteInput"
        />
        <view class="field-btn {{binding ? 'is-disabled' : ''}}" bindtap="onBindWechat">
          {{binding ? '绑定中' : '绑定'}}
        </view>
      </view>
    </block>
  </view>

  <!-- 设置项：修改口令 -->
  <view class="panel">
    <view class="panel-head">
      <view class="panel-title">修改口令</view>
    </view>
    <input
      class="field-input block-input"
      password
      placeholder="原口令"
      value="{{oldPassword}}"
      bindinput="onOldPasswordInput"
    />
    <input
      class="field-input block-input"
      password
      placeholder="新口令（至少 6 位）"
      value="{{newPassword}}"
      bindinput="onNewPasswordInput"
    />
    <input
      class="field-input block-input"
      password
      placeholder="再次输入新口令"
      value="{{confirmPassword}}"
      bindinput="onConfirmPasswordInput"
    />
    <button class="save-btn" disabled="{{saving}}" bindtap="onChangePassword">
      {{saving ? '保存中…' : '保存新口令'}}
    </button>
  </view>

  <view class="footer-logout" bindtap="onLogout">退出登录</view>
  <view wx:if="{{versionText}}" class="version-line">{{versionText}}</view>
</view>
