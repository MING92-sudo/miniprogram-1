/* 使用单位个人中心：仅单位信息 + 设置项（绑定微信 / 修改口令 / 退出） */
.unit-card { margin-bottom: 20rpx; }
.unit-label { font-size: 24rpx; color: #86909c; }
.unit-name { margin-top: 6rpx; font-size: 34rpx; font-weight: 600; }
.unit-row { display: flex; margin-top: 16rpx; font-size: 26rpx; }
.unit-row-label { width: 140rpx; color: #86909c; }
.unit-row-value { flex: 1; color: var(--em-text, #1d2129); }
.unit-tip { margin-top: 16rpx; font-size: 22rpx; line-height: 1.6; color: #86909c; }
.portal-btn { margin-top: 20rpx; }

.section-title { font-size: 28rpx; font-weight: 600; }

.bind-box { margin-top: 16rpx; }
.bind-input { height: 76rpx; padding: 0 20rpx; background: #f7f8fa; border-radius: 12rpx; font-size: 26rpx; }
.pwd-input { margin-top: 16rpx; }
.bind-btn { margin-top: 16rpx; }
.bind-tip { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; }
.bind-state { margin-top: 16rpx; font-size: 24rpx; color: #00b42a; }

.version-line { text-align: center; padding: 24rpx 0; font-size: 24rpx; }
