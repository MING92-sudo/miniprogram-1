<view class="em-page">
  <view class="em-card tip-card">
    <view class="em-text-secondary">{{text.SIGN_HINT}}</view>
  </view>

  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>

  <view wx:if="{{failed}}" class="em-card">
    <view class="em-text-secondary">记录暂不可用，请稍后重试</view>
    <button class="em-btn-ghost retry" bindtap="onRetry">重试</button>
  </view>

  <view wx:if="{{!loading && !failed && !list.length}}" class="em-card em-text-secondary">{{text.EMPTY_RECORD}}</view>

  <view wx:for="{{list}}" wx:key="id" class="em-card">
    <view class="row-head">
      <view class="row-main">
        <view class="row-title">{{item.subtitle || '未命名电梯'}}</view>
        <view class="em-text-secondary">{{item.workType || '-'}} · 作业 {{item.workerName || '-'}}{{item.assistantName ? ' / ' + item.assistantName : ''}}</view>
      </view>
      <text class="tag {{item.confirmed ? 'is-ok' : 'is-todo'}}">{{item.confirmText}}</text>
    </view>
    <view class="info-row"><text>到场</text><text>{{item.checkinTime || '-'}}</text></view>
    <view class="info-row"><text>签退</text><text>{{item.checkoutTime || '-'}}</text></view>
    <view class="info-row"><text>作业时长</text><text>{{item.duration || '-'}}</text></view>
    <button
      wx:if="{{item.shareToken}}"
      class="em-btn-ghost sign-btn"
      data-rid="{{item.id}}"
      data-token="{{item.shareToken}}"
      bindtap="goSign"
    >去确认签字</button>
  </view>
</view>
