<view class="em-page">
  <view class="page-head">
    <view class="page-head-title">报修</view>
    <view class="page-head-sub">选择电梯并填写故障情况</view>
  </view>
  <view wx:if="{{loading}}" class="em-card em-text-secondary">加载中...</view>

  <view wx:if="{{!loading && !elevators.length}}" class="em-card em-text-secondary">{{text.EMPTY_ELEVATOR}}</view>

  <block wx:if="{{elevators.length}}">
    <view class="em-card">
      <view class="form-label">电梯</view>
      <picker mode="selector" range="{{elevatorLabels}}" value="{{elevatorIndex}}" bindchange="onElevatorChange">
        <view class="picker-box">
          {{elevatorIndex > -1 ? elevatorLabels[elevatorIndex] : '请选择本单位电梯'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>

      <view class="form-label">故障等级</view>
      <radio-group class="type-row" bindchange="onTypeChange">
        <label wx:for="{{faultTypes}}" wx:key="*this" class="type-radio">
          <radio value="{{item}}" checked="{{faultType === item}}" color="#0A5BD3" />
          <text class="{{item === '困人（紧急）' ? 'type-emergency' : ''}}">{{item}}</text>
        </label>
      </radio-group>
      <view wx:if="{{faultType === '困人（紧急）'}}" class="em-text-secondary type-tip">
        困人为紧急故障，将优先派单；请同时电话联系维保单位
      </view>

      <view class="form-label">故障描述</view>
      <textarea class="form-textarea" value="{{desc}}" data-field="desc" bindinput="onInput" maxlength="500" placeholder="故障现象（如：关门后不运行、有异响）" />

      <view class="form-label">故障位置</view>
      <input class="form-input" value="{{siteDesc}}" data-field="siteDesc" bindinput="onInput" placeholder="如：1 楼厅门 / 轿厢内" />

      <view class="form-label">现场照片（最多 3 张）</view>
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="*this" class="photo-item">
          <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewPhoto" />
          <view class="photo-del" data-index="{{index}}" bindtap="onRemovePhoto">×</view>
        </view>
        <view wx:if="{{photos.length < 3}}" class="photo-item photo-add" bindtap="onAddPhoto">＋</view>
      </view>
    </view>

    <view class="em-card">
      <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">提交报修</button>
      <view class="em-text-secondary tip">{{text.REPORT_TIP}}</view>
    </view>
  </block>
</view>
