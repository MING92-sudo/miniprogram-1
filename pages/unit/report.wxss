.form-label {
  font-weight: 600;
  margin: 20rpx 0 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
  font-size: 28rpx;
}

.picker-arrow {
  color: var(--em-text-disabled);
}

.type-row {
  display: flex;
  gap: 32rpx;
}

.type-radio {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
}

.type-emergency {
  color: var(--em-error);
  font-weight: 600;
}

.type-tip {
  margin-top: 8rpx;
}

.form-input,
.form-textarea {
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}

.form-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
}

.form-textarea {
  padding: 16rpx 20rpx;
  min-height: 160rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--em-radius);
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #00000099;
  color: #ffffff;
  border-radius: 0 0 0 var(--em-radius);
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--em-bg-page);
  color: var(--em-text-secondary);
  font-size: 64rpx;
}

.tip {
  margin-top: 12rpx;
  text-align: center;
}
