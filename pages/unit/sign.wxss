.sign-page {
  min-height: 100vh;
  background: var(--em-bg-page);
  padding-bottom: 60rpx;
}

.info-row {
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.k {
  color: var(--em-text-secondary);
}

.confirmed {
  color: var(--em-success);
  font-weight: 700;
  margin-bottom: 16rpx;
}

.sig-img {
  width: 100%;
  height: 160rpx;
  background: var(--em-bg-page);
  border-radius: 12rpx;
}

.sign-canvas {
  width: 100%;
  height: 360rpx;
  background: var(--em-bg-page);
  border: 2rpx solid var(--em-border);
  border-radius: 12rpx;
}

.sign-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
