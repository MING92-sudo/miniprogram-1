.sign-page {
  min-height: 100vh;
  background: #f0f4fa;
  padding-bottom: 60rpx;
}

.info-row {
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.k {
  color: #86909c;
}

.confirmed {
  color: #2ba471;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.sig-img {
  width: 100%;
  height: 160rpx;
  background: #f5f8fd;
  border-radius: 12rpx;
}

.stars {
  display: flex;
  gap: 16rpx;
  font-size: 44rpx;
  color: #c9cdd4;
}

.star-active {
  color: #ffa940;
}

.sign-canvas {
  width: 100%;
  height: 360rpx;
  background: #f5f8fd;
  border: 2rpx solid #e5e6eb;
  border-radius: 12rpx;
}

.sign-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
