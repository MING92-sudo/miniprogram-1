<view class="bw">
  <nav-bar title="审计" bind:back="onBack"></nav-bar>
  <view class="page-pad tabbar-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view wx:for="{{list}}" wx:key="index" class="card col gap4">
        <view class="kv"><span>操作人</span><b>{{item.actorId || '—'}}</b></view>
        <view class="kv"><span>动作</span><b>{{item.action || '—'}}</b></view>
        <view class="kv"><span>时间</span><b>{{item.createdAt || '—'}}</b></view>
      </view>
      <empty-state wx:if="{{!list.length}}" mode="empty" title="暂无数据" desc="数据范围内暂无记录。"></empty-state>
      <perm-button perm="data:export_sensitive" capability="敏感导出" allowRoles="平台管理员（需审批）" type="ghost" text="敏感导出（管理端办理）"></perm-button>
    </block>
  </view>
<custom-tabbar></custom-tabbar>
</view>
