<view class="bw">
  <nav-bar title="合同" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view wx:for="{{list}}" wx:key="index" class="card col gap4">
        <view class="kv"><span>合同编号</span><b>{{item.contractNo || '—'}}</b></view>
        <view class="kv"><span>使用单位</span><b>{{item.useUnitName || '—'}}</b></view>
        <view class="kv"><span>到期日</span><b>{{item.endDate || '—'}}</b></view>
      </view>
      <empty-state wx:if="{{!list.length}}" mode="empty" title="暂无数据" desc="数据范围内暂无记录。"></empty-state>
      <perm-button perm="contract:edit" capability="新增合同" allowRoles="维保部经理、平台管理员" type="ghost" text="新增合同（管理端办理）"></perm-button>
    </block>
  </view>
</view>
