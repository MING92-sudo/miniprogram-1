<view class="bw">
  <nav-bar title="角色权限矩阵" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view wx:for="{{list}}" wx:key="code" class="card col gap4">
        <view class="kv"><span>权限码</span><b class="mono">{{item.code || '—'}}</b></view>
        <view class="kv"><span>允许角色</span><b>{{item.allowed.join('、') || '—'}}</b></view>
        <view class="kv" wx:if="{{item.conditional.length}}"><span>受限角色</span><b>{{item.conditional.join('、')}}</b></view>
      </view>
      <empty-state wx:if="{{!list.length}}" mode="empty" title="暂无数据" desc="数据范围内暂无记录。"></empty-state>
      <perm-button perm="role:assign" capability="分配角色" allowRoles="平台管理员" type="ghost" text="分配角色（管理端办理）"></perm-button>
    </block>
  </view>
</view>
