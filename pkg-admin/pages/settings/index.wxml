<view class="bw">
  <nav-bar title="系统配置" back="{{false}}"></nav-bar>
  <view class="page-pad tabbar-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view class="rule-note"><text class="i i-circle-info"></text><text>仅平台管理员可修改；取值约束由管理端定义，每次保存写审计留痕。</text></view>
      <view wx:for="{{items}}" wx:key="key" class="card row between" data-item="{{item}}" bindtap="onEdit" aria-role="button">
        <view class="grow">
          <view class="fs22 w6">{{item.remark || item.key}}</view>
          <view class="mono fs20 dim mt2">{{item.key}} = {{item.value}}</view>
        </view>
        <text class="i i-chevron-right dim"></text>
      </view>
      <empty-state wx:if="{{!items.length}}" mode="empty" title="暂无配置项" desc="配置项由平台维护。"></empty-state>
    </block>
  </view>
  <custom-tabbar></custom-tabbar>
</view>