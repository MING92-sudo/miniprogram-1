<view class="bw">
  <nav-bar title="人员" bind:back="onBack"></nav-bar>
  <view class="page-pad tabbar-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view wx:for="{{list}}" wx:key="index" class="card col gap4">
        <view class="kv"><span>姓名</span><b>{{item.name || '—'}}</b></view>
        <view class="kv"><span>账号</span><b>{{item.account || '—'}}</b></view>
        <view class="kv"><span>角色</span><b>{{item.roleText || '—'}}</b></view>
      </view>
      <empty-state wx:if="{{!list.length}}" mode="empty" title="暂无数据" desc="数据范围内暂无记录。"></empty-state>
      <perm-button perm="user:create" capability="开通账号" allowRoles="各单位管理员、平台管理员" type="ghost" text="开通账号（管理端办理）"></perm-button>
    </block>
  </view>
<custom-tabbar></custom-tabbar>
</view>
