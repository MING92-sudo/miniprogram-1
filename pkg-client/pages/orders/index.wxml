<view class="bw">
  <nav-bar title="本单位工单" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:elif="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="card col gap6" data-id="{{item.id}}" bindtap="goDetail" aria-role="button">
        <view class="row between">
          <view class="fs22 w7 grow">{{item.elevatorName || item.elevatorCode}}</view>
          <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}"></status-tag>
        </view>
        <view class="fs20 dim">{{item.desc}}</view>
        <view class="mono fs20 dim">{{item.createdAt}}</view>
      </view>
    </block>
    <empty-state wx:else mode="empty" title="暂无工单" desc="本单位报修后会出现在这里。" actionText="一键报修" bind:action="goReport"></empty-state>
  </view>
</view>