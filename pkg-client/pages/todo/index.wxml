<view class="bw">
  <nav-bar title="待办签字" back="{{false}}"></nav-bar>
  <view class="page-pad tabbar-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <!-- V2.80 签字提醒（临期/超期消息中心推送） -->
      <block wx:if="{{messages.length}}">
        <view wx:for="{{messages}}" wx:key="id" class="card col gap4 todo-msg">
          <view class="row between">
            <text class="fs22 w6 amber">{{item.title}}</text>
            <text class="fs20 dim" data-id="{{item.id}}" catchtap="dismissMessage" aria-role="button">知道了</text>
          </view>
          <view class="fs20 muted">{{item.content}}</view>
          <view class="fs20 dim">{{item.createdAt}}</view>
        </view>
      </block>

      <sec-head title="待签记录单" action-text="{{records.length ? (batchMode ? '退出批量' : '批量签字') : ''}}" bind:action="toggleBatch"></sec-head>
      <block wx:if="{{records.length}}">
        <view wx:for="{{records}}" wx:key="id" class="card row between"
          data-item="{{item}}" data-id="{{item.id}}"
          bindtap="onRecordTap" aria-role="button">
          <view class="row gap8 grow">
            <view wx:if="{{batchMode}}" class="cb todo-cb {{selected[item.id] ? 'on' : ''}}">
              <text wx:if="{{selected[item.id]}}" class="i i-check cb-ico"></text>
            </view>
            <view class="grow">
              <view class="fs22 w6">{{item.elevatorName}} · {{item.workType || '维保'}}记录单</view>
              <view class="fs20 dim mt2">{{item.id}} · 待签署</view>
              <view wx:if="{{item.deadlineLabel}}" class="fs20 mt2 {{item.deadlineClass}}">签字截止 {{item.signDeadline}}（{{item.deadlineLabel}}）</view>
            </view>
          </view>
          <button wx:if="{{!batchMode}}" class="btn btn-primary btn-xs">去签字</button>
        </view>
      </block>
      <empty-state wx:else mode="empty" title="暂无待签记录单" desc="维保发起签署后会出现在这里。"></empty-state>

      <!-- P1 T8-I2：客户急修确认已关闭（入口+能力双重下线），客户主体不渲染本区块 -->
      <block wx:if="{{showFaults}}">
        <sec-head title="待确认急修单"></sec-head>
        <block wx:if="{{faults.length}}">
          <view wx:for="{{faults}}" wx:key="id" class="card row between" data-id="{{item.id}}" bindtap="goFault" aria-role="button">
            <view class="grow">
              <view class="fs22 w6">{{item.elevatorName || item.elevatorCode}} · 急修单</view>
              <view class="fs20 dim mt2">{{item.desc}} · 待确认</view>
            </view>
            <button class="btn btn-ghost btn-xs">去确认</button>
          </view>
        </block>
        <empty-state wx:else mode="empty" title="暂无待确认急修单" desc="急修提交后会出现在这里。"></empty-state>
      </block>
    </block>
  </view>
  <!-- V2.80 批量签字底栏 -->
  <view wx:if="{{batchMode}}" class="page-footer todo-batchbar">
    <text class="fs20 dim">已选 {{selectedCount}} 条（单次最多 {{batchLimit}} 条）</text>
    <button class="btn btn-primary" catchtap="goBatchSign"><text class="i i-signature"></text> 批量签署{{selectedCount ? '（' + selectedCount + '）' : ''}}</button>
  </view>
  <custom-tabbar></custom-tabbar>
</view>
