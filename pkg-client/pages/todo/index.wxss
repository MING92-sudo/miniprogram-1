page{background:var(--ink);color:var(--text)}
.todo-msg{border-left:6rpx solid var(--amber)}
.todo-cb{width:32rpx;height:32rpx;border-radius:6rpx;border:1rpx solid var(--amber);display:flex;align-items:center;justify-content:center;flex:none;align-self:center}
.todo-cb.on{background:var(--amber)}
.cb-ico{font-size:18rpx;color:#171005}
/* 批量签字底栏：避开底部 tabbar */
.todo-batchbar{bottom:120rpx}
