<view class="bw">
<nav-bar title="{{ct.TITLE}}"></nav-bar>
<view class="em-page">
  <block wx:if="{{canWrite}}">
    <view class="plate">
      <view class="row between">
        <text class="mono fs18 amber ls12">HANDOVER / {{form.projectName || '—'}}</text>
        <text class="tag tag-amber">待发起</text>
      </view>
      <view class="disp fs40 mt6">{{form.elevatorName || form.projectName || '—'}}</view>
      <view class="fs18 muted mt2">{{ct.PREVIEW_SUB}}</view>
    </view>
    <view class="stepper">
      <block wx:for="{{flow}}" wx:key="label">
        <view wx:if="{{index > 0}}" class="step-line"></view>
        <view class="step {{item.state}}"><view class="dot">{{index + 1}}</view><text>{{item.label}}</text></view>
      </block>
    </view>

    <view class="em-card">
      <view class="section-title">{{ct.PROJECT}}</view>
      <view class="field">
        <view class="field-label">使用单位<text class="req">*</text></view>
        <picker mode="selector" range="{{useUnitOptions}}" range-key="unitName" value="{{useUnitIndex}}" bindchange="onUseUnitChange">
          <view class="field-picker">{{useUnitIndex >= 0 ? useUnitOptions[useUnitIndex].unitName : '请选择使用单位档案'}}<text class="field-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">项目名称（小区）<text class="req">*</text></view>
        <input class="field-input" value="{{form.projectName}}" data-field="projectName" bindinput="onInput" placeholder="如：世纪大厦" />
      </view>
      <view class="field">
        <view class="field-label">监督检验合格日</view>
        <picker mode="date" value="{{form.supervisionPassDate}}" bindchange="onDateChange">
          <view class="field-picker">{{form.supervisionPassDate || '请选择日期'}}<text class="field-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">维保类别</view>
        <picker mode="selector" range="{{workTypeLabels}}" value="{{workTypeIndex}}" bindchange="onWorkTypeChange">
          <view class="field-picker">{{workTypeIndex > -1 ? workTypeLabels[workTypeIndex] : '请选择维保类别（首保按半月保预建）'}}<text class="field-arrow">›</text></view>
        </picker>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">{{ct.ELEVATOR}}</view>
      <view class="field"><view class="field-label">电梯编码（可空，归档时 2.7 回填）</view><input class="field-input" value="{{form.elevatorCode}}" data-field="elevatorCode" bindinput="onInput" placeholder="未注册可留空" /></view>
      <view class="field"><view class="field-label">电梯名称</view><input class="field-input" value="{{form.elevatorName}}" data-field="elevatorName" bindinput="onInput" placeholder="如：1# 客梯" /></view>
      <view class="field"><view class="field-label">电梯品种</view><picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="field-picker">{{form.category || '请选择品种（TSG T5002 四类）'}}<text class="field-arrow">›</text></view></picker></view>
      <view class="field"><view class="field-label">安装地址</view><input class="field-input" value="{{form.location}}" data-field="location" bindinput="onInput" placeholder="楼栋门牌" /></view>
      <view class="field"><view class="field-label">注册代码（可空，归档时回填）</view><input class="field-input" value="{{form.regCode}}" data-field="regCode" bindinput="onInput" placeholder="未注册可留空" /></view>
      <view class="field"><view class="field-label">设备代码（可空，归档时回填）</view><input class="field-input" value="{{form.deviceCode}}" data-field="deviceCode" bindinput="onInput" placeholder="未获取可留空" /></view>
      <view class="field"><view class="field-label">单位内编号<text class="req">*</text></view><input class="field-input" value="{{form.insideNumber}}" data-field="insideNumber" bindinput="onInput" placeholder="如：KT-01" /></view>
      <view class="field"><view class="field-label">型号</view><input class="field-input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="如：OTIS 300VF" /></view>
      <view class="field"><view class="field-label">品牌</view><input class="field-input" value="{{form.brand}}" data-field="brand" bindinput="onInput" placeholder="品牌" /></view>
      <view class="field"><view class="field-label">制造单位</view><input class="field-input" value="{{form.manufacturer}}" data-field="manufacturer" bindinput="onInput" placeholder="制造单位全称" /></view>
      <view class="field"><view class="field-label">厂家出厂编号<text class="req">*</text></view><input class="field-input" value="{{form.factoryNumber}}" data-field="factoryNumber" bindinput="onInput" placeholder="归档时用于 2.7 查询" /></view>
      <view class="field"><view class="field-label">驱动方式</view><input class="field-input" value="{{form.driveMode}}" data-field="driveMode" bindinput="onInput" placeholder="如：曳引驱动" /></view>
      <view class="field"><view class="field-label">额定载重</view><input class="field-input" type="number" value="{{form.ratedLoad}}" data-field="ratedLoad" bindinput="onInput" placeholder="1000" /><text class="field-unit">{{form.ratedLoadUnit}}</text></view>
      <view class="field"><view class="field-label">额定速度</view><input class="field-input" type="digit" value="{{form.ratedSpeed}}" data-field="ratedSpeed" bindinput="onInput" placeholder="1.75" /><text class="field-unit">{{form.ratedSpeedUnit}}</text></view>
      <view class="field"><view class="field-label">层站/门</view><input class="field-input" value="{{form.stationsDoors}}" data-field="stationsDoors" bindinput="onInput" placeholder="如：11/11" /></view>
    </view>

    <view class="em-card">
      <view class="section-title">移交资料（全部必传）</view>
      <view wx:for="{{docs}}" wx:key="field" class="field row between">
        <view>
          <view class="field-label">{{item.label}}<text class="req">*</text></view>
          <view class="fs20 dim mt2">{{item.fileId ? '已上传' : '请选择 PDF / JPG / PNG 文件'}}</view>
        </view>
        <button class="btn btn-ghost btn-xs" data-field="{{item.field}}" bindtap="onChooseDoc" disabled="{{uploadingField}}">{{item.fileId ? '替换' : '上传'}}</button>
      </view>
      <view class="fs18 dim">三份资料上传成功后才能创建移交单；监督检验报告同时用于归档设备档案。</view>
    </view>

    <view class="em-card">
      <view class="em-text-secondary tip">{{ct.TIP}}</view>
    </view>
  </block>

  <view wx:else class="em-card">
    <view class="section-title">移交单</view>
    <view class="em-text-secondary">{{text.READONLY_TIP}}</view>
  </view>
</view>
  <view class="page-footer" wx:if="{{canWrite}}">
    <button class="btn btn-primary co-f-main" disabled="{{submitting}}" bindtap="onSubmit">{{ct.SUBMIT}}</button>
  </view>
</view>
