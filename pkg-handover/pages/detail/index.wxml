<view class="bw">
<nav-bar title="移交单详情"></nav-bar>
<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">{{loadingText}}</view>

  <block wx:if="{{handover}}">
    <view class="em-card">
      <view class="head-row">
        <view>
          <view class="order-no">{{handover.handoverNo}}</view>
          <view class="em-text-secondary">{{handover.projectName}}</view>
        </view>
        <view class="tag tag-{{handover.status}}">{{statusText}}</view>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">流程进度</view>
      <view class="steps">
        <view wx:for="{{steps}}" wx:key="key" class="step step-{{item.state}}">
          <view class="step-dot">{{item.state === 'done' ? '✓' : index + 1}}</view>
          <view class="step-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">电梯信息</view>
      <view class="info-row"><text>电梯代码</text><text>{{handover.elevatorCode || '-'}}</text></view>
      <view class="info-row"><text>电梯名称</text><text>{{handover.elevatorName || '-'}}</text></view>
      <view class="info-row"><text>电梯品种</text><text>{{handover.category || '-'}}</text></view>
      <view class="info-row"><text>安装地址</text><text>{{handover.location || '-'}}</text></view>
      <view class="info-row"><text>注册代码</text><text>{{handover.regCode || '-'}}</text></view>
      <view class="info-row"><text>设备代码</text><text>{{handover.deviceCode || '-'}}</text></view>
      <view class="info-row"><text>内部编号</text><text>{{handover.insideNumber || '-'}}</text></view>
      <view class="info-row"><text>型号</text><text>{{handover.model || '-'}}</text></view>
      <view class="info-row"><text>品牌</text><text>{{handover.brand || '-'}}</text></view>
      <view class="info-row"><text>制造单位</text><text>{{handover.manufacturer || '-'}}</text></view>
      <view class="info-row"><text>产品编号</text><text>{{handover.productNo || '-'}}</text></view>
      <view class="info-row"><text>驱动方式</text><text>{{handover.driveMode || '-'}}</text></view>
      <view class="info-row"><text>额定载重</text><text>{{handover.ratedLoad ? handover.ratedLoad + (handover.ratedLoadUnit || '') : '-'}}</text></view>
      <view class="info-row"><text>额定速度</text><text>{{handover.ratedSpeed ? handover.ratedSpeed + (handover.ratedSpeedUnit || '') : '-'}}</text></view>
      <view class="info-row"><text>层站/门</text><text>{{handover.stationsDoors || '-'}}</text></view>
      <view class="info-row"><text>维保类别</text><text>{{workTypeText || '-'}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">3 必传资料</view>
      <view wx:for="{{docs}}" wx:key="field" class="doc-row">
        <view class="doc-main">
          <view class="doc-label">{{item.label}}</view>
          <view class="em-text-secondary">{{item.uploaded ? '已上传' : '待上传'}}</view>
        </view>
        <view
          wx:if="{{canDocs}}"
          class="doc-action"
          data-index="{{index}}"
          bindtap="onPickDoc"
        >{{uploadingIndex === index ? '上传中…' : (item.uploaded ? '重新上传' : '上传')}}</view>
        <view wx:else class="doc-state {{item.uploaded ? 'is-ok' : 'is-todo'}}">{{item.uploaded ? '✓' : '—'}}</view>
      </view>
      <button wx:if="{{canDocs}}" class="em-btn-primary doc-submit" disabled="{{submitting}}" bindtap="onSubmitDocs">提交资料</button>
      <view wx:if="{{canDocs}}" class="em-text-secondary doc-tip">三项资料齐全后本单转「现场查验」，缺一不可提交</view>
    </view>

    <view class="em-card">
      <view class="section-title">接收工程师</view>
      <view class="info-row"><text>当前接收人</text><text>{{handover.receiverName || '未分配'}}</text></view>
      <block wx:if="{{canAssign}}">
        <block wx:if="{{!manualReceiver}}">
          <picker mode="selector" range="{{receiverNames}}" value="{{receiverIndex}}" bindchange="onReceiverChange">
            <view class="picker-row">
              {{receiverIndex > -1 ? receiverNames[receiverIndex] : '选择接收工程师'}}
              <text class="field-arrow">›</text>
            </view>
          </picker>
        </block>
        <block wx:else>
          <view class="em-text-secondary doc-tip">{{text.RECEIVER_MANUAL_TIP}}</view>
          <view class="field">
            <view class="field-label">工号（人员 ID）</view>
            <input class="field-input" value="{{manualReceiverId}}" data-field="manualReceiverId" bindinput="onManualReceiverInput" placeholder="emp-xxxx" />
          </view>
          <view class="field">
            <view class="field-label">姓名</view>
            <input class="field-input" value="{{manualReceiverName}}" data-field="manualReceiverName" bindinput="onManualReceiverInput" placeholder="接收工程师姓名" />
          </view>
        </block>
        <button class="em-btn-ghost doc-submit" disabled="{{submitting}}" bindtap="onAssign">确认分配</button>
      </block>
    </view>

    <view class="em-card">
      <view class="section-title">关键记录</view>
      <view class="info-row"><text>发起时间</text><text>{{handover.createdAt || '-'}}</text></view>
      <view class="info-row"><text>发起人</text><text>{{handover.initiatorName || '-'}}</text></view>
      <view class="info-row"><text>监督检验合格日</text><text>{{handover.supervisionPassDate || '-'}}</text></view>
      <view class="info-row"><text>确认人</text><text>{{handover.confirmedByName || '-'}}</text></view>
      <view class="info-row"><text>确认时间</text><text>{{handover.confirmedAt || '-'}}</text></view>
      <view class="info-row" wx:if="{{handover.elevatorId}}"><text>归档电梯 ID</text><text>{{handover.elevatorId}}</text></view>
    </view>

    <view class="em-card">
      <view class="section-title">现场查验与整改</view>
      <view class="em-text-secondary">{{text.DETAIL_GAP_TIP}}</view>
      <view wx:if="{{handover.handoverIssue}}" class="issue-tip">本单首保时标记了遗留问题，需跟踪闭环</view>
    </view>

    <view class="em-card" wx:if="{{canInspect || canRectify || canConfirm}}">
      <button wx:if="{{canInspect}}" class="em-btn-primary" bindtap="goInspect">现场查验</button>
      <button wx:if="{{canRectify}}" class="em-btn-primary" bindtap="goRectify">上传整改并复验</button>
      <button wx:if="{{canConfirm}}" class="em-btn-primary" bindtap="goConfirm">确认归档</button>
    </view>
  </block>
</view>

</view>
