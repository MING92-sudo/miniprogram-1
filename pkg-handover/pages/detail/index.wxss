page{background:var(--ink);color:var(--text)}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-no {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: var(--em-text-secondary);
}

.info-row text:first-child {
  color: var(--em-text-primary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-row text:last-child {
  text-align: right;
}

.tag {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
}

.tag-DOC_SUBMITTING {
  color: var(--em-warning);
  background: var(--em-warning-bg);
}

.tag-INSPECTING {
  color: var(--em-brand);
  background: var(--em-brand-light);
}

.tag-RECTIFYING {
  color: var(--em-error);
  background: var(--em-error-bg);
}

.tag-PENDING_CONFIRM {
  color: var(--em-warning);
  background: var(--em-warning-bg);
}

.tag-ARCHIVED {
  color: var(--em-success);
  background: var(--em-success-bg);
}

.steps {
  display: flex;
  justify-content: space-between;
}

.step {
  flex: 1;
  text-align: center;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--em-text-disabled);
  background: var(--em-neutral-bg);
}

.step-done .step-dot {
  color: #ffffff;
  background: var(--em-success);
}

.step-current .step-dot {
  color: #ffffff;
  background: var(--em-brand);
}

.step-label {
  font-size: 22rpx;
  color: var(--em-text-secondary);
}

.step-current .step-label {
  color: var(--em-brand);
  font-weight: 600;
}

.doc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.doc-row:last-of-type {
  border-bottom: none;
}

.doc-label {
  font-size: 28rpx;
}

.doc-action {
  color: var(--em-brand);
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  background: var(--em-brand-light);
  border-radius: var(--em-radius);
}

.doc-state {
  font-size: 28rpx;
}

.doc-state.is-ok {
  color: var(--em-success);
}

.doc-state.is-todo {
  color: var(--em-text-disabled);
}

.doc-submit {
  margin-top: 20rpx;
}

.doc-tip {
  margin-top: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.field-label {
  width: 220rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: right;
}

.picker-row {
  margin-top: 12rpx;
  padding: 20rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  color: var(--em-text-secondary);
}

.field-arrow {
  margin-left: 8rpx;
  color: var(--em-text-disabled);
}

.em-btn-ghost {
  margin-top: 16rpx;
  background: var(--em-brand-light);
  color: var(--em-brand);
  border-radius: var(--em-radius);
}

.issue-tip {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  color: var(--em-error);
  background: var(--em-error-bg);
  border-radius: var(--em-radius);
  font-size: 24rpx;
}
