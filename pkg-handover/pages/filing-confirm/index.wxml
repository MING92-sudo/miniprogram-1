<view class="bw">
<nav-bar title="交接确认"></nav-bar>
<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">{{loadingText}}</view>

  <block wx:if="{{filing}}">
    <view class="em-card">
      <view class="head-row">
        <view>
          <view class="order-no">{{filing.filingNo}}</view>
          <view class="em-text-secondary">{{filing.projectName || '-'}}</view>
        </view>
        <view class="tag">待交接确认</view>
      </view>
    </view>

    <view class="em-card">
      <view class="section-title">归档摘要</view>
      <view class="info-row"><text>电梯名称</text><text>{{filing.elevatorName || '-'}}</text></view>
      <view class="info-row"><text>电梯代码</text><text>{{filing.elevatorCode || '-'}}</text></view>
      <view class="info-row"><text>使用单位</text><text>{{filing.useUnitId || '-'}}</text></view>
      <view class="info-row"><text>合同</text><text>{{filing.contractId || '-'}}</text></view>
      <view class="info-row"><text>发起人</text><text>{{filing.initiatorName || '-'}}</text></view>
    </view>

    <view wx:if="{{locked}}" class="em-card">
      <view class="em-text-secondary">本单当前不可确认（需「待交接确认」状态 + 安装部/维保经理及以上岗位）</view>
    </view>

    <block wx:if="{{!locked}}">
      <view class="em-card">
        <view class="section-title">交接内容</view>
        <view class="field">
          <view class="field-label">钥匙工具核对</view>
          <input class="field-input" value="{{keyToolCheck}}" data-field="keyToolCheck" bindinput="onInput" placeholder="如：钥匙 3 把、工具齐套" />
        </view>
        <view class="em-text-secondary field-tip">遗留问题（无则留空；缺件待补办请在此写明补办计划）</view>
        <textarea class="field-textarea" value="{{leftoverIssue}}" data-field="leftoverIssue" bindinput="onInput" maxlength="300" placeholder="遗留问题与后续安排" />
      </view>

      <view class="em-card">
        <view class="section-title">签字</view>
        <view class="field">
          <view class="field-label">对方签字人<text class="req">*</text></view>
          <input class="field-input" value="{{counterpartName}}" data-field="counterpartName" bindinput="onInput" placeholder="使用单位签字人姓名" />
        </view>

        <view class="sign-row">
          <view class="sign-cell">
            <view class="sign-title">对方手写签名<text class="req">*</text></view>
            <view class="sign-box" data-slot="counterpart" bindtap="openSignature">
              <image wx:if="{{counterpartPath}}" src="{{counterpartPath}}" mode="aspectFit" />
              <text wx:else class="sign-add">＋ 手写签名</text>
            </view>
          </view>
          <view class="sign-cell">
            <view class="sign-title">我方签字（可选）</view>
            <view class="sign-box" data-slot="our" bindtap="openSignature">
              <image wx:if="{{ourPath}}" src="{{ourPath}}" mode="aspectFit" />
              <text wx:else class="sign-add">＋ 手写签名</text>
            </view>
          </view>
        </view>
        <view class="em-text-secondary field-tip">我方账号「节点通过即签字」：确认人取当前登录账号，签名图可选</view>
      </view>

      <view class="em-card">
        <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmit">提交确认并归档</button>
      </view>
    </block>
  </block>
</view>

</view>
