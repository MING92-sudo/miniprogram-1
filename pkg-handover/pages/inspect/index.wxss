page{background:var(--ink);color:var(--text)}
.hi-item{display:flex;flex-direction:column}
.hi-star{margin-left:12rpx}
.hi-res{flex:1;text-align:center;border:1rpx solid #34454D;border-radius:6rpx;padding:12rpx;font-size:20rpx;color:#DCE6E9}
.hi-res.on-ok{background:rgba(47,196,141,.15);border-color:var(--ok);color:var(--ok-soft);font-weight:700}
.hi-res.on-ng{background:rgba(255,75,43,.15);border-color:var(--signal);color:var(--signal-soft);font-weight:700}
.hi-res.on-na{background:rgba(255,255,255,.06);border-color:var(--muted);color:var(--text);font-weight:700}
.hi-input{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:14rpx 18rpx;font-size:22rpx;color:var(--text)}
.hi-ph{color:var(--dim)}
.hi-textarea{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:14rpx;font-size:22rpx;color:var(--text);min-height:90rpx;width:100%}
.hi-photo-wrap{position:relative}
.hi-photo-del{position:absolute;top:-12rpx;right:-12rpx;width:36rpx;height:36rpx;border-radius:50%;background:var(--signal);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:20rpx}
.hi-photo-add{display:flex;align-items:center;justify-content:center;border:1rpx dashed #40535C;background:rgba(255,255,255,.02);color:var(--amber);font-size:28rpx}
.hi-cond{display:flex;align-items:center;gap:12rpx;padding:8rpx 0}
.cb{width:28rpx;height:28rpx;border-radius:4rpx;border:1rpx solid var(--amber);display:flex;align-items:center;justify-content:center;flex:none}
.cb.on{background:var(--amber)}
.cb-ico{font-size:18rpx;color:#171005}