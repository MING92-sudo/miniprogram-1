page{background:var(--ink);color:var(--text)}
.hi-item{display:flex;flex-direction:column}
.hi-star{margin-left:12rpx}
.hi-req{margin-top:10rpx;font-size:20rpx;line-height:1.6;color:var(--muted)}
.hi-clause{display:inline-block;margin-right:12rpx;padding:2rpx 10rpx;border:1rpx solid var(--line-2);border-radius:4rpx;font-size:18rpx;color:var(--dim)}
.hi-photo-hint{align-self:center;font-size:18rpx;color:var(--dim)}
.hi-res{flex:1;text-align:center;border:1rpx solid #C6D0D7;border-radius:6rpx;padding:12rpx;font-size:20rpx;color:#2B3B44}
.hi-res.on-ok{background:rgba(30,158,110,.12);border-color:var(--ok);color:var(--ok-soft);font-weight:700}
.hi-res.on-ng{background:rgba(229,72,44,.1);border-color:var(--signal);color:var(--signal-soft);font-weight:700}
.hi-res.on-na{background:rgba(23,36,45,.05);border-color:var(--muted);color:var(--text);font-weight:700}
.hi-input{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:14rpx 18rpx;font-size:22rpx;color:var(--text)}
.hi-ph{color:var(--dim)}
.hi-textarea{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:14rpx;font-size:22rpx;color:var(--text);min-height:90rpx;width:100%}
.hi-photo-wrap{position:relative}
.hi-photo-del{position:absolute;top:-12rpx;right:-12rpx;width:36rpx;height:36rpx;border-radius:50%;background:var(--signal);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:20rpx}
.hi-photo-add{display:flex;align-items:center;justify-content:center;border:1rpx dashed #B7C3CB;background:rgba(23,36,45,.02);color:var(--amber);font-size:28rpx}
.hi-cond{display:flex;align-items:center;gap:12rpx;padding:8rpx 0}
.cb{width:28rpx;height:28rpx;border-radius:4rpx;border:1rpx solid var(--amber);display:flex;align-items:center;justify-content:center;flex:none}
.cb.on{background:var(--amber)}
.cb-ico{font-size:18rpx;color:#171005}