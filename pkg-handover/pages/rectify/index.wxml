<view class="bw">
  <nav-bar title="整改回复" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view class="plate" wx:if="{{handover}}">
        <view class="mono fs18 dim ls12">HANDOVER / 移交单</view>
        <view class="hr-kv mt6"><text class="dim">移交单号</text><text class="mono">{{handover.handoverNo}}</text></view>
        <view class="hr-kv"><text class="dim">设备</text><text>{{handover.elevatorName}} {{handover.deviceCode}}</text></view>
        <view class="hr-kv"><text class="dim">状态</text><text>验收中 · 待整改复验</text></view>
      </view>

      <view class="rule-note"><text class="i i-circle-info"></text><text>不合格项 1:1 映射检查项，不可增删；逐条复验全部 PASS 才回待确认。</text></view>
      <empty-state wx:if="{{!rects.length}}" mode="empty" title="暂无整改项" desc="查验不合格项会自动生成整改清单。"></empty-state>

      <block wx:for="{{rects}}" wx:key="id">
        <view class="hr-sec-head">
          <text class="panel-title mono">RECTIFY / 整改项（{{rects.length}}）</text>
        </view>
        <view class="hr-item {{item.recheckResult === 'PASS' ? 'ok' : ''}}">
          <view class="row between">
            <text class="fs24 w6 grow">{{item.itemName || ('检查项 ' + item.itemNo)}}</text>
            <status-tag text="{{item.recheckResult === 'PASS' ? '复验通过' : (item.recheckResult === 'FAIL' ? '复验不通过' : (item.afterPhotoFileId ? '待复验' : '需整改'))}}" tone="{{item.recheckResult === 'PASS' ? 'ok' : (item.recheckResult === 'FAIL' ? 'signal' : 'signal')}}"></status-tag>
          </view>
          <view class="fs18 dim mt4">维保现场验收发现 · {{item.itemType}}{{item.failDesc ? ' · ' + item.failDesc : ''}}</view>
        </view>

        <block wx:if="{{canRectify && !item.afterPhotoFileId}}">
          <view class="hr-sec-head"><text class="panel-title mono">REPLY / 整改说明</text><text class="fs18 dim">必填</text></view>
          <textarea class="hr-textarea" value="{{item.rectMeasure}}" data-idx="{{item.idx}}" bindinput="onMeasure" placeholder="填写整改措施与复测结果" placeholder-class="hr-ph"></textarea>

          <view class="hr-sec-head"><text class="panel-title mono">PHOTO / 整改照片</text><text class="fs18 dim">必填 · 复测留证</text></view>
          <view class="photo-row">
            <image wx:for="{{item.photos}}" wx:for-item="p" wx:key="*this" class="thumb" src="{{p}}" mode="aspectFill"></image>
            <view class="thumb hr-photo-add" data-idx="{{item.idx}}" bindtap="choosePhoto" aria-role="button"><text class="i i-camera"></text></view>
          </view>

          <button class="btn btn-primary" disabled="{{submitting}}" data-idx="{{item.idx}}" bindtap="onRectify"><text class="i i-file-circle-check"></text> 提交整改 · 申请复验</button>
        </block>
        <view wx:elif="{{canRecheck && item.afterPhotoFileId}}" class="row gap8">
          <button class="btn btn-ghost btn-sm grow" disabled="{{submitting}}" data-idx="{{item.idx}}" data-result="FAIL" bindtap="onRecheck">复验不通过</button>
          <button class="btn btn-primary btn-sm grow" disabled="{{submitting}}" data-idx="{{item.idx}}" data-result="PASS" bindtap="onRecheck">复验通过</button>
        </view>
        <view class="fs18 dim hr-foot-note"><text class="i i-circle-check"></text> 提交后回到「验收中」，待维保主管复验通过后进入双方签字（屏 02）。</view>
      </block>
    </block>
  </view>
</view>
