<view class="bw">
<nav-bar title="整改回复"></nav-bar>
<view class="em-page">
  <view wx:if="{{loading}}" class="em-card em-text-secondary">{{loadingText}}</view>

  <block wx:if="{{handover}}">
    <view class="em-card">
      <view class="section-title">{{handover.handoverNo}}</view>
      <view class="em-text-secondary">{{handover.projectName}} · {{handover.elevatorName || handover.elevatorCode || '未填电梯名称'}}</view>
      <view class="em-text-secondary">勾选需整改项并上传整改前/后照片，复验通过后转「待确认归档」</view>
    </view>

    <view wx:if="{{locked}}" class="em-card">
      <view class="em-text-secondary">本单当前不在「整改复验中」，无需整改</view>
    </view>

    <block wx:if="{{!locked}}">
      <view class="em-card">
        <view class="section-title">整改项（不合格项）</view>
        <view wx:for="{{items}}" wx:key="itemType" class="item {{item.selected ? 'is-selected' : ''}}">
          <view class="item-head" data-index="{{index}}" bindtap="onToggle">
            <text class="item-label">{{item.label}}</text>
            <view class="item-check">{{item.selected ? '✓ 需整改' : '不符合则勾选'}}</view>
          </view>

          <block wx:if="{{item.selected}}">
            <view class="photo-row">
              <view class="photo-cell">
                <view class="photo-title">整改前</view>
                <view class="photo-box" data-index="{{index}}" data-kind="before" bindtap="onPick">
                  <image wx:if="{{item.beforePath}}" src="{{item.beforePath}}" mode="aspectFill" data-src="{{item.beforePath}}" catchtap="preview" />
                  <text wx:else class="photo-add">{{uploading === index + '-before' ? '上传中…' : '＋ 拍照'}}</text>
                </view>
              </view>
              <view class="photo-cell">
                <view class="photo-title">整改后</view>
                <view class="photo-box" data-index="{{index}}" data-kind="after" bindtap="onPick">
                  <image wx:if="{{item.afterPath}}" src="{{item.afterPath}}" mode="aspectFill" data-src="{{item.afterPath}}" catchtap="preview" />
                  <text wx:else class="photo-add">{{uploading === index + '-after' ? '上传中…' : '＋ 拍照'}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{canRectify}}" class="em-card">
        <button class="em-btn-primary" disabled="{{submitting}}" bindtap="onSubmitRectify">提交整改</button>
      </view>

      <view wx:if="{{canRecheck}}" class="em-card">
        <view class="section-title">复验</view>
        <view class="em-text-secondary">整改照片核对后判定：通过 → 待确认归档；不通过 → 保持整改中</view>
        <view class="recheck-row">
          <button class="em-btn-ghost recheck-btn" disabled="{{submitting}}" bindtap="onRecheckPass">复验通过</button>
          <button class="em-btn-ghost recheck-btn is-fail" disabled="{{submitting}}" bindtap="onRecheckFail">复验不通过</button>
        </view>
      </view>
    </block>
  </block>
</view>

</view>
