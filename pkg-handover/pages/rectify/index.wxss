page{background:var(--ink);color:var(--text)}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--em-border);
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
}

.item-check {
  font-size: 22rpx;
  color: var(--em-text-secondary);
}

.is-selected .item-check {
  color: var(--em-error);
  font-weight: 600;
}

.photo-row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.photo-cell {
  flex: 1;
}

.photo-title {
  font-size: 24rpx;
  color: var(--em-text-secondary);
  margin-bottom: 8rpx;
}

.photo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  background: var(--em-bg-page);
  border-radius: var(--em-radius);
  overflow: hidden;
}

.photo-box image {
  width: 100%;
  height: 100%;
}

.photo-add {
  font-size: 26rpx;
  color: var(--em-text-secondary);
}

.recheck-row {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.recheck-btn {
  flex: 1;
  margin: 0;
  background: var(--em-success-bg);
  color: var(--em-success);
  border-radius: var(--em-radius);
}

.recheck-btn.is-fail {
  background: var(--em-error-bg);
  color: var(--em-error);
}
