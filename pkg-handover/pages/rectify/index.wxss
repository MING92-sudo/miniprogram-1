/* 整改回复（屏 24 · 原型 V1.4）：移交单抬头 + RECTIFY/REPLY/PHOTO 分节 + 逐条提交/复验 */
page{background:var(--ink);color:var(--text)}
.panel-title{font-size:20rpx;letter-spacing:.16em;color:var(--dim)}
.hr-kv{display:flex;justify-content:space-between;gap:24rpx;font-size:20rpx;padding:10rpx 0;border-bottom:1rpx dashed rgba(38,52,59,.7)}
.hr-kv:last-child{border-bottom:none}
.hr-sec-head{display:flex;justify-content:space-between;align-items:center;padding:6rpx 2rpx 0}
.hr-item{border:1rpx solid #243138;border-left:4rpx solid var(--signal);border-radius:6rpx;background:rgba(255,255,255,.02);padding:18rpx 20rpx}
.hr-item.ok{border-left-color:var(--ok)}
.hr-textarea{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:18rpx;font-size:22rpx;color:var(--text);min-height:140rpx;width:100%;box-sizing:border-box}
.hr-ph{color:var(--dim)}
.hr-photo-add{display:flex;align-items:center;justify-content:center;border:1rpx dashed #40535C;background:rgba(255,255,255,.02);color:var(--amber);font-size:28rpx}
.hr-foot-note{display:flex;gap:10rpx;line-height:1.6}
.hr-foot-note .i{color:var(--ok);flex:none;margin-top:2rpx}
