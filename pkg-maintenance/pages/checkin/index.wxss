page{background:var(--ink);color:var(--text)}
.ci-step{font-size:18rpx;color:var(--amber-soft);border:1rpx solid rgba(232,160,0,.4);border-radius:4rpx;padding:4rpx 10rpx}
.ci-geo{font-size:20rpx;line-height:1.6;border-radius:6rpx;padding:12rpx 16rpx}
.ci-geo-OK{color:var(--ok-soft);background:rgba(30,158,110,.08)}
.ci-geo-NEAR{color:var(--amber-soft);background:rgba(232,160,0,.08)}
.ci-geo-OVER{color:var(--signal-soft);background:rgba(229,72,44,.08)}
.ci-geo-UNKNOWN{color:var(--muted);background:rgba(23,36,45,.04)}
.ci-code-box{display:flex;flex-direction:column;align-items:center;gap:8rpx;border:1rpx dashed rgba(232,160,0,.4);border-radius:8rpx;padding:20rpx}
.ci-code{font-size:56rpx;font-weight:700;letter-spacing:12rpx;color:var(--amber)}
.ci-role{flex:1;text-align:center;border:1rpx solid #C6D0D7;border-radius:8rpx;padding:18rpx;font-size:24rpx;color:#2B3B44}
.ci-role.on{background:var(--amber);color:#1A1203;border-color:var(--amber);font-weight:700}
.ci-input{background:#F7F9FA;border:1rpx solid #C9D3DA;border-radius:6rpx;padding:20rpx;font-size:32rpx;letter-spacing:8rpx;color:var(--text);text-align:center}
.ci-ph{color:var(--dim);letter-spacing:0}
.ci-photo-wrap{display:flex;align-items:center;gap:16rpx}
.ci-photo{width:200rpx;height:150rpx;border-radius:6rpx;border:1rpx solid #C6D0D7}
.ci-photo-empty{display:flex;align-items:center;justify-content:center;gap:12rpx;border:1rpx dashed #B7C3CB;border-radius:8rpx;padding:48rpx;color:var(--dim);font-size:22rpx}
.ci-photo-empty .i{font-size:32rpx;color:var(--amber)}.page-pad{padding-bottom:calc(160rpx + env(safe-area-inset-bottom,0px))}
.co-f-main{flex:1}
