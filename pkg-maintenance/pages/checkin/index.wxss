page{background:var(--ink);color:var(--text)}
.ci-step{font-size:18rpx;color:var(--amber);border:1rpx solid rgba(255,176,32,.35);border-radius:4rpx;padding:4rpx 10rpx}
.ci-geo{font-size:20rpx;line-height:1.6;border-radius:6rpx;padding:12rpx 16rpx}
.ci-geo-OK{color:var(--ok-soft);background:rgba(47,196,141,.08)}
.ci-geo-NEAR{color:var(--amber-soft);background:rgba(255,176,32,.08)}
.ci-geo-OVER{color:var(--signal-soft);background:rgba(255,75,43,.08)}
.ci-geo-UNKNOWN{color:var(--muted);background:rgba(255,255,255,.04)}
.ci-code-box{display:flex;flex-direction:column;align-items:center;gap:8rpx;border:1rpx dashed rgba(255,176,32,.4);border-radius:8rpx;padding:20rpx}
.ci-code{font-size:56rpx;font-weight:700;letter-spacing:12rpx;color:var(--amber)}
.ci-role{flex:1;text-align:center;border:1rpx solid #34454D;border-radius:8rpx;padding:18rpx;font-size:24rpx;color:#DCE6E9}
.ci-role.on{background:var(--amber);color:#1A1203;border-color:var(--amber);font-weight:700}
.ci-input{background:#0D1519;border:1rpx solid #3A4A51;border-radius:6rpx;padding:20rpx;font-size:32rpx;letter-spacing:8rpx;color:var(--text);text-align:center}
.ci-ph{color:var(--dim);letter-spacing:0}
.ci-photo-wrap{display:flex;align-items:center;gap:16rpx}
.ci-photo{width:200rpx;height:150rpx;border-radius:6rpx;border:1rpx solid #35454D}
.ci-photo-empty{display:flex;align-items:center;justify-content:center;gap:12rpx;border:1rpx dashed #40535C;border-radius:8rpx;padding:48rpx;color:var(--dim);font-size:22rpx}
.ci-photo-empty .i{font-size:32rpx;color:var(--amber)}