<view class="bw">
  <nav-bar title="双人动态码"></nav-bar>
  <view class="page-pad col gap10">
    <view class="card col gap10">
      <view class="row gap8">
        <view class="dc-mode {{mode === 'ISSUE' ? 'on' : ''}}" data-mode="ISSUE" bindtap="switchMode">我是主维保（生成码）</view>
        <view class="dc-mode {{mode === 'INPUT' ? 'on' : ''}}" data-mode="INPUT" bindtap="switchMode">我是配合人员（输入码）</view>
      </view>

      <block wx:if="{{mode === 'ISSUE'}}">
        <view class="fs20 muted">请让配合维保人员当面输入以下动态码，验证同时到场</view>
        <view class="dc-display mono">{{code || '------'}}</view>
        <view class="fs20 dim">{{countdown}} 秒后自动刷新 · 单码有效期 {{ttlSeconds}} 秒{{expiresAt ? ' · 本码至 ' + expiresAt : ''}}</view>
        <view wx:if="{{errorText}}" class="fs20 sig">{{errorText}}</view>
        <view class="rule-note"><text class="i i-circle-info"></text><text>动态码与本工单绑定，配合人员签到成功后即失效（不可重放）</text></view>
      </block>

      <block wx:elif="{{mode === 'INPUT'}}">
        <view class="fs20 muted">请向主维保人员索取当屏动态码并输入</view>
        <input class="dc-input mono" type="number" maxlength="6" placeholder="请输入 6 位动态码" placeholder-class="dc-ph" value="{{inputCode}}" bindinput="onCodeInput" />
        <view wx:if="{{errorText}}" class="fs20 sig">{{errorText}}</view>
        <button class="btn btn-primary" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '校验中...' : '确认校验并签到'}}</button>
        <view class="fs20 dim">校验不通过可重试</view>
      </block>

      <view wx:else class="fs20 muted">正在识别您的作业角色...</view>
    </view>
  </view>
</view>