<view class="bw">
  <nav-bar title="我的维保工单" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <view class="search">
      <text class="i i-magnifying-glass"></text>
      <input class="ol-input" value="{{keyword}}" bindinput="onSearch" placeholder="搜索电梯 / 工单号" placeholder-class="ol-ph" />
      <text class="i i-qrcode ol-scan" bindtap="onScan"></text>
    </view>

    <view class="tabs">
      <button wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onTabChange">{{item.label}}</button>
    </view>

    <view wx:if="{{dueLabel}}" class="alert-strip">
      <text class="i i-clock amber"></text>
      <text class="grow fs20">{{dueLabel}}</text>
      <button class="link fs20" bindtap="clearDue">清除</button>
    </view>

    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:120},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:elif="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="card oc" data-id="{{item.id}}" bindtap="goDetail" aria-role="button" aria-label="{{item.elevatorName}}">
        <view class="row between">
          <view class="oc-type">{{item.workType || '维保'}}</view>
          <status-tag text="{{item.statusText}}" tone="{{item.status === 'DONE' ? 'ok' : 'amber'}}"></status-tag>
        </view>
        <view class="oc-name">{{item.elevatorName || item.elevatorCode}}</view>
        <view wx:if="{{item.metaLine}}" class="oc-meta">{{item.metaLine}}</view>
        <view wx:if="{{item.deviceLine}}" class="oc-dev mono">{{item.deviceLine}}</view>
        <view class="oc-grid">
          <view class="oc-cell">
            <text class="oc-k">计划时间</text>
            <text class="oc-v mono">{{item.planTime || '—'}}</text>
          </view>
          <view class="oc-cell">
            <text class="oc-k">工单号</text>
            <text class="oc-v mono">{{item.orderNo || '—'}}</text>
          </view>
          <view class="oc-cell">
            <text class="oc-k">作业人员</text>
            <text class="oc-v">{{item.workerLine || '—'}}</text>
          </view>
          <view class="oc-cell" wx:if="{{item.status === 'PROCESSING'}}">
            <text class="oc-k">签到时间</text>
            <text class="oc-v mono">{{item.checkinTime || '—'}}</text>
          </view>
          <view class="oc-cell" wx:if="{{item.status === 'DONE'}}">
            <text class="oc-k">作业时长</text>
            <text class="oc-v mono">{{item.duration || '—'}}</text>
          </view>
        </view>
        <view class="row between oc-foot">
          <view class="row gap6 oc-tags">
            <text wx:if="{{item.dueTag}}" class="oc-tag {{item.dueTag.cls}}">{{item.dueTag.text}}</text>
            <text wx:if="{{item.elapsedText}}" class="oc-tag amber">{{item.elapsedText}}</text>
            <text wx:if="{{item.reportTag}}" class="oc-tag {{item.reportTag.cls}}">{{item.reportTag.text}}</text>
          </view>
          <button class="btn {{item.status === 'DONE' ? 'btn-ghost' : 'btn-primary'}} btn-xs" data-id="{{item.id}}" data-status="{{item.status}}" catchtap="onAction">
            {{item.status === 'PENDING' ? '去签到' : (item.status === 'PROCESSING' ? '继续作业' : '查看')}}
          </button>
        </view>
      </view>
      <view wx:if="{{list.length < total}}" class="hint">上拉加载更多</view>
    </block>
    <empty-state wx:else mode="{{emptyMode}}" title="{{emptyMode === 'filtered' ? '没有匹配的工单' : emptyTitle}}" desc="{{emptyMode === 'filtered' ? '换个筛选条件试试。' : '派单后工单会出现在这里。'}}"></empty-state>
  </view>
</view>