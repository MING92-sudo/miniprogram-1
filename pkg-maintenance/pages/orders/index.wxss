page{background:var(--ink);color:var(--text)}
.ol-input{flex:1;font-size:24rpx;color:var(--text)}
.ol-ph{color:var(--dim)}
.ol-scan{font-size:32rpx;color:var(--amber)}
.oc{display:flex;flex-direction:column;gap:10rpx}
.oc-type{flex:none;font-size:18rpx;color:var(--amber-soft);border:1rpx solid rgba(232,160,0,.4);border-radius:4rpx;padding:2rpx 12rpx;letter-spacing:.04em}
.oc-name{font-size:30rpx;font-weight:700;color:var(--text);line-height:1.35}
.oc-meta{font-size:20rpx;color:var(--muted)}
.oc-dev{font-size:18rpx;color:var(--dim)}
.oc-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx 20rpx;border-top:1rpx solid var(--line);padding-top:14rpx}
.oc-cell{display:flex;flex-direction:column;gap:2rpx;min-width:0}
.oc-k{font-size:18rpx;color:var(--dim)}
.oc-v{font-size:21rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.oc-foot{border-top:1rpx solid var(--line);padding-top:14rpx}
.oc-tags{flex:1;min-width:0;flex-wrap:wrap}
.oc-tag{flex:none;font-size:18rpx;padding:2rpx 10rpx;border-radius:4rpx;border:1rpx solid var(--line);color:var(--dim)}
.oc-tag.amber{color:var(--amber-soft);border-color:rgba(232,160,0,.4)}
.oc-tag.sig{color:var(--signal-soft);border-color:rgba(229,72,44,.4)}
.oc-tag.ok{color:var(--ok-soft);border-color:rgba(30,158,110,.4)}
.pool-head{margin-top:8rpx}
