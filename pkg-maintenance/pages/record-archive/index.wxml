<view class="bw">
  <nav-bar title="归档与导出" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10">
    <skeleton wx:if="{{loading}}" rows="{{[{h:120},{h:160}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry" bind:back="onBack"></error-retry>
    <block wx:else>
      <view class="card col gap8">
        <view class="row gap8"><text class="i i-file-pdf fs38 amber"></text><text class="fs24 w7">维保记录归档</text></view>
        <view class="kv"><span>归档时间</span><b>{{archive.archivedAt || '—'}}</b></view>
        <view class="kv"><span>SHA-256</span><b class="mono ra-hash">{{archive.hash || '—'}}</b></view>
        <view class="rule-note"><text class="i i-shield-halved"></text><text>归档由系统在客户签署后自动生成（PDF + SHA-256），不触发监管平台重复上报。</text></view>
      </view>
      <button class="btn btn-primary" bindtap="onOpenPdf"><text class="i i-file-export"></text> 打开 / 导出 PDF</button>
    </block>
  </view>
</view>