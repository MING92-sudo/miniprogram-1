page{background:var(--ink);color:var(--text)}
.rd-meta{display:grid;grid-template-columns:1fr 1fr;gap:6rpx 20rpx;font-size:20rpx;color:#6B6150;padding:12rpx 0}
.rd-meta b{color:var(--paper-ink);font-weight:600;margin-left:8rpx}
.rd-item{padding:14rpx 0;border-bottom:1rpx dashed rgba(38,52,59,.7)}
.rd-item:last-child{border-bottom:none}
.rd-res{font-size:20rpx;flex:none;margin-left:16rpx}
.rd-photo-ng{border-color:var(--signal)}
.rd-hash{font-size:18rpx;word-break:break-all}