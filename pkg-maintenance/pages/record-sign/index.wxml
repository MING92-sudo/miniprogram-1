<view class="bw">
  <nav-bar title="维保双人签字" bind:back="onBack"></nav-bar>
  <view class="page-pad col gap10 rs-pad">
    <skeleton wx:if="{{loading}}" rows="{{[{h:100},{h:160},{h:120}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <view class="card row between">
        <view>
          <view class="fs24 w7">{{order.elevatorName || order.elevator.elevatorName}}</view>
          <view class="fs20 dim mt2">我的身份：{{myRoleText}}</view>
        </view>
        <status-tag text="{{isDual ? '双人作业' : '单人作业'}}" tone="amber"></status-tag>
      </view>

      <view class="card col gap8">
        <view class="panel-title">签字状态（各自手机签）</view>
        <view class="rs-row">
          <view class="grow">
            <view class="fs22 w6">主检人 · {{order.workerName || '—'}}</view>
            <view class="fs20 {{workerSigned ? 'ok' : 'dim'}} mt2">{{workerSignText}}</view>
          </view>
          <image wx:if="{{order.workerSignatureUrl}}" class="rs-sig" src="{{order.workerSignatureUrl}}" mode="aspectFit"></image>
          <status-tag text="{{workerSigned ? '已签' : '未签'}}" tone="{{workerSigned ? 'ok' : 'dim'}}"></status-tag>
        </view>
        <view wx:if="{{isDual}}" class="rs-row">
          <view class="grow">
            <view class="fs22 w6">配合人 · {{order.assistantName || '—'}}</view>
            <view class="fs20 {{assistantSigned ? 'ok' : 'dim'}} mt2">{{assistantSignText}}</view>
          </view>
          <image wx:if="{{order.assistantSignatureUrl}}" class="rs-sig" src="{{order.assistantSignatureUrl}}" mode="aspectFit"></image>
          <status-tag text="{{assistantSigned ? '已签' : '未签'}}" tone="{{assistantSigned ? 'ok' : 'dim'}}"></status-tag>
        </view>
        <view class="rule-note"><text class="i i-circle-info"></text><text>主检与配合须为不同账号，各自在本机签字；双签齐后方可发起使用单位签字。</text></view>
      </view>

      <view wx:if="{{order.recordInfo}}" class="card col gap6">
        <view class="panel-title">版本 / 哈希核对</view>
        <view class="kv"><span>记录单版本号</span><b class="mono">{{order.recordInfo.version || 'v1'}}</b></view>
        <view wx:if="{{order.recordInfo.hash}}" class="kv"><span>SHA-256 前 8 位</span><b class="mono">{{order.recordInfo.hash}}</b></view>
      </view>
    </block>
  </view>
  <view class="page-footer" wx:if="{{!loading && !error}}">
    <button class="btn btn-ghost rs-foot-ghost" bindtap="goRecord">查看记录单</button>
    <button class="btn btn-primary rs-foot-main" disabled="{{primaryDisabled}}" bindtap="onPrimary"><text class="i i-signature"></text> {{primaryText}}</button>
  </view>
</view>
