<view class="bw">
  <nav-bar title="维保作业 · {{workType || '半月保'}}" bind:back="onBack"></nav-bar>

  <view class="page-pad col gap10 tk-page">
    <skeleton wx:if="{{loading}}" rows="{{[{h:140},{h:60},{h:80},{h:80},{h:80}]}}"></skeleton>
    <error-retry wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry"></error-retry>
    <block wx:else>
      <!-- 概览（原型屏 04）：梯名/单号/进度/依据/计数 + 作业入口 -->
      <view class="card col gap6">
        <view class="row between">
          <view class="fs26 w7 grow">{{elevatorName}}</view>
          <text class="tag tag-amber">{{workType}}</text>
        </view>
        <view class="fs20 dim mono">{{order.orderNo || orderId}} · {{doneCount}} / {{requiredTotal}} 项</view>
        <view class="progress mt4"><i style="width:{{progress}}%"></i></view>
        <view class="row between mt4">
          <text class="fs18 dim">依据 TSG T5002—2017</text>
          <text class="fs20"><text class="ok">合格 {{normalCount}}</text> · <text class="sig">异常 {{abnormalCount}}</text> · <text class="dim">不适用 {{naCount}}</text></text>
        </view>
        <view class="row gap8 mt6">
          <button class="btn btn-ghost btn-sm grow" bindtap="goCheckin">签到</button>
          <button class="btn btn-ghost btn-sm grow" bindtap="goSign">签字</button>
          <button class="btn btn-primary btn-sm grow" bindtap="goCheckout">签退</button>
        </view>
        <button wx:if="{{order && order.status === 'DONE'}}" class="btn btn-ghost btn-sm" bindtap="goRecord">查看记录单</button>
      </view>

      <!-- 配合人选择（D3/D8：认领后必选，双人作业才可签退；候选=同区域持平台ID，未签到前可改选） -->
      <view wx:if="{{needPartner}}" class="card col gap6">
        <view class="fs22 w6">{{poolText.PARTNER_TITLE}}</view>
        <view class="fs18 dim">{{poolText.PARTNER_TIP}}</view>
        <picker wx:if="{{partnerList.length}}" mode="selector" range="{{partnerOptions}}" bindchange="onPartnerChange">
          <view class="tk-input">{{partnerName || poolText.PARTNER_PH}}</view>
        </picker>
        <view wx:else class="fs18 sig">{{poolText.PARTNER_EMPTY}}</view>
        <button wx:if="{{partnerList.length}}" class="btn btn-primary btn-sm" disabled="{{partnerIndex < 0 || assigning}}" bindtap="onAssignPartner">{{poolText.PARTNER_BTN}}</button>
      </view>

      <!-- 分组 collapsible + 逐项行内留证 -->
      <view wx:for="{{sections}}" wx:key="label" class="col gap6">
        <button class="group-head" data-label="{{item.label}}" bindtap="onToggleGroup" aria-role="button" aria-label="{{item.label}}">
          <text class="row gap6 tk-gh-title"><text class="i {{collapsed[item.label] ? 'i-chevron-right' : 'i-chevron-down'}} fs18 dim"></text>{{item.label}}</text>
          <text class="mono fs18 dim tk-gh-count">{{item.done}} / {{item.total}}{{collapsed[item.label] ? ' · 折叠' : ''}}</text>
        </button>
        <block wx:if="{{!collapsed[item.label]}}">
          <view
            wx:for="{{item.items}}"
            wx:for-item="it"
            wx:key="id"
            id="item-{{it.id}}"
            class="ck {{it.glyphClass}} {{expandedId === it.id ? 'ck-open' : ''}}"
          >
            <view class="ck-row" data-id="{{it.id}}" bindtap="goItemForm" aria-role="button" aria-label="{{it.name}}">
              <text class="tk-glyph {{it.glyphClass}}">{{it.glyph}}</text>
              <view class="grow">
                <view class="fs22 {{it.result ? 'w6' : ''}}">{{it.name}}</view>
                <view class="fs20 dim mt2 {{it.subClass}}">{{it.sub}}</view>
                <view wx:if="{{it.result === 'ABNORMAL' && it.abnormalDesc}}" class="fs18 sig mt2">强制备注：{{it.abnormalDesc}}</view>
              </view>
              <view class="col tk-right">
                <text class="tk-res {{it.resultClass}}">{{it.resultText || (it.notInThisRun ? '本次无需' : '待检')}}</text>
                <text wx:if="{{it.photoCount}}" class="fs18 dim"><text class="i i-images"></text> {{it.photoCount}}</text>
              </view>
            </view>

            <view wx:if="{{it.notInThisRun}}" class="row between ck-skip">
              <text class="fs18 dim">周期性条目 · {{it.nextRunText || '本次无需执行'}}</text>
              <button class="link fs18" data-id="{{it.id}}" catchtap="onRunThisTime">本次执行</button>
            </view>

            <!-- 行内展开：结果/实测/异常/NA/照片（合规校验同原 item-form） -->
            <view wx:if="{{expandedId === it.id}}" class="ck-edit col gap8">
              <view class="row gap8">
                <view class="tk-result {{result === 'NORMAL' ? 'on-ok' : ''}}" data-value="NORMAL" bindtap="onResultChange">合格</view>
                <view class="tk-result {{result === 'ABNORMAL' ? 'on-ng' : ''}}" data-value="ABNORMAL" bindtap="onResultChange">异常</view>
                <view class="tk-result {{result === 'NA' ? 'on-na' : ''}}" data-value="NA" bindtap="onResultChange">不适用</view>
              </view>

              <view wx:if="{{it.judgeType === 'NUMERIC' && result !== 'NA'}}" class="col gap4">
                <text class="fs20 muted">测量读数{{it.valueUnit ? '（' + it.valueUnit + '）' : ''}}</text>
                <input class="tk-input" type="digit" value="{{value}}" bindinput="onValueInput" placeholder="请输入读数" placeholder-class="tk-ph" />
                <text wx:if="{{it.valueMin != null || it.valueMax != null}}" class="fs18 dim">标准范围 {{it.valueMin}} ~ {{it.valueMax}}{{it.valueUnit}}</text>
              </view>

              <view wx:if="{{it.judgeType === 'MANUFACTURER' && result !== 'NA'}}" class="col gap4">
                <text class="fs20 muted">说明书判定</text>
                <input class="tk-input" value="{{valueText}}" bindinput="onValueTextInput" placeholder="按制造单位说明书填写" placeholder-class="tk-ph" />
              </view>

              <view wx:if="{{result === 'ABNORMAL'}}" class="col gap6">
                <text class="fs20 muted">异常描述（必填）</text>
                <textarea class="tk-textarea" value="{{abnormalDesc}}" bindinput="onAbnormalInput" placeholder="描述异常现象" placeholder-class="tk-ph"></textarea>
                <text class="fs20 muted">隐患代码（必填，S1–S7）</text>
                <picker mode="selector" range="{{problemOptions}}" bindchange="onProblemChange">
                  <view class="tk-input">{{problemDesc || '请选择隐患代码'}}</view>
                </picker>
              </view>

              <view wx:if="{{result === 'NA'}}" class="col gap4">
                <text class="fs20 muted">跳过原因（必填）</text>
                <input class="tk-input" value="{{skipReason}}" bindinput="onSkipInput" placeholder="不适用原因（TSG 注 A-1）" placeholder-class="tk-ph" />
              </view>

              <view class="col gap6">
                <view class="row between">
                  <text class="fs20 muted">现场照片{{it.isKey ? '（关键项须留证）' : ''}}</text>
                  <text class="fs18 dim">{{editPhotos.length}}/4</text>
                </view>
                <view class="photo-row">
                  <view wx:for="{{editPhotos}}" wx:key="url" class="tk-photo-wrap">
                    <image class="thumb" src="{{item.url}}" mode="aspectFill" data-src="{{item.url}}" bindtap="previewEditPhoto"></image>
                    <text class="tk-photo-del" data-index="{{index}}" catchtap="removePhoto"><text class="i i-xmark"></text></text>
                  </view>
                  <view class="thumb tk-photo-add" bindtap="choosePhoto" aria-role="button"><text class="i i-camera"></text></view>
                </view>
              </view>

              <view class="row gap8">
                <button class="btn btn-primary btn-sm grow" disabled="{{submitting}}" bindtap="onSubmitItem">{{submitting ? '保存中...' : '保存检查项'}}</button>
                <button class="btn btn-ghost btn-sm grow" data-id="{{it.id}}" bindtap="goItemForm">收起</button>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="sync-row"><text class="i i-cloud-arrow-up fs18 amber"></text> 已完成 {{doneCount}} 项已缓存 · 弱网自动续传</view>
    </block>
  </view>

  <!-- 底栏（原型屏 04）：存草稿 + 下一项（按钮等宽均分；文案不拼接条目名，避免长标题撑破底栏） -->
  <view class="tk-footer row gap8">
    <button class="btn btn-ghost grow" bindtap="onSaveDraft">存草稿</button>
    <button class="btn btn-primary grow" bindtap="onNextItem">下一项</button>
  </view>
</view>