/* 遗留 em-* 浅色类的主题补全（.bw 作用域）：M4/M5 迁移页包裹 .bw 后统一走浅色令牌，保留旧 WXML 绑定。
   2026-11-21 随全局深色改浅色同步（原深色覆盖已替换为浅色值）。 */
.bw .em-page{background:transparent;color:var(--text);padding:0}
.bw .em-card{background:var(--panel);border:1rpx solid var(--line);border-radius:8rpx;color:var(--text)}
.bw .em-text-secondary{color:var(--muted)}
.bw .em-btn-primary{background:var(--amber);color:#1A1203;border-radius:10rpx}
.bw .page-head-title{color:var(--text)}
.bw .page-head-sub{color:var(--muted)}
.bw input,.bw textarea{color:var(--text)}
.bw .step-title,.bw .section-title,.bw .head-title{color:var(--text)}
.bw .info-row{color:var(--text);border-bottom:1rpx dashed rgba(23,36,45,.12)}
.bw .info-row text:first-child{color:var(--dim)}
/* 迁移页表单与列表补全（.bw 作用域）：旧 em 与 field 系列浅色类统一走浅色令牌。 */
.bw .field{border-bottom:1rpx solid var(--line)}
.bw .field-label{color:var(--muted)}
.bw .field-input{color:var(--text)}
.bw .field-picker{color:var(--text)}
.bw .field-arrow{color:var(--dim)}
.bw .field-unit{color:var(--muted)}
.bw .req{color:var(--signal-soft)}
.bw .input-placeholder{color:var(--dim)}
.bw .doc-row{border-bottom:1rpx solid var(--line)}
.bw .doc-label{color:var(--text)}
.bw .doc-action{background:rgba(232,160,0,.1);color:var(--amber-soft);border:1rpx solid rgba(232,160,0,.3)}
.bw .doc-state.is-ok{color:var(--ok-soft)}
.bw .doc-state.is-todo{color:var(--dim)}
.bw .picker-row{background:var(--panel);border:1rpx solid #C9D3DA;color:var(--text)}
.bw .em-btn-ghost{background:var(--panel);border:1rpx solid #B9C6CE;color:#2B3B44}
.bw .issue-tip{background:rgba(229,72,44,.06);color:var(--signal-soft);border:1rpx solid rgba(229,72,44,.3)}
.bw .doc-tip{color:var(--dim)}
.bw .tag-DOC_SUBMITTING,.bw .tag-PENDING_INST_REVIEW{color:var(--amber-soft);background:rgba(232,160,0,.1);border:1rpx solid rgba(232,160,0,.35)}
.bw .tag-INSPECTING{color:var(--amber-soft);background:rgba(232,160,0,.1);border:1rpx solid rgba(232,160,0,.35)}
.bw .tag-RECTIFYING{color:var(--signal-soft);background:rgba(229,72,44,.08);border-color:rgba(229,72,44,.35)}
.bw .tag-PENDING_CONFIRM{color:var(--ok-soft);background:rgba(30,158,110,.1);border:1rpx solid rgba(30,158,110,.35)}
.bw .tag-ARCHIVED{color:var(--ok-soft);background:rgba(30,158,110,.1);border:1rpx solid rgba(30,158,110,.35)}
.bw .step-dot{background:var(--panel);border:1rpx solid var(--line-2);color:var(--dim)}
.bw .step-done .step-dot{background:rgba(30,158,110,.12);border-color:rgba(30,158,110,.45);color:var(--ok-soft)}
.bw .step-current .step-dot{background:var(--amber);border-color:var(--amber);color:#1A1203}
.bw .step-label{color:var(--dim)}
.bw .step-current .step-label{color:var(--amber-soft)}
